<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_dmag_journey_rule_company" model="ir.rule">
        <field name="name">Luật hành trình: theo phòng khám</field>
        <field name="model_id" ref="model_dmag_journey_rule"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_dmag_journey_execution_company" model="ir.rule">
        <field name="name">Nhật ký hành trình: theo phòng khám</field>
        <field name="model_id" ref="model_dmag_journey_execution"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_dmag_nps_response_company" model="ir.rule">
        <field name="name">Khảo sát NPS: theo phòng khám</field>
        <field name="model_id" ref="model_dmag_nps_response"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
