<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_dmag_journey" model="ir.ui.view">
        <field name="name">res.company.form.dmag.journey</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="dmag_zalo_zns.view_company_form_dmag_zns"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='dmag_zalo_zns']" position="after">
                <page string="Chăm sóc khách hàng" name="dmag_journey">
                    <group>
                        <group string="Phân công">
                            <field name="dmag_cskh_user_id"/>
                            <field name="dmag_cskh_lead_user_id"/>
                        </group>
                        <group string="Liên kết gửi khách">
                            <field name="dmag_painless_video_url" widget="url"/>
                            <field name="dmag_health_declaration_url" widget="url"/>
                            <field name="dmag_google_review_url" widget="url"/>
                            <field name="dmag_referral_message"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
