<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dmag_journey_execution_tree" model="ir.ui.view">
        <field name="name">dmag.journey.execution.tree</field>
        <field name="model">dmag.journey.execution</field>
        <field name="arch" type="xml">
            <tree string="Nhật ký hành trình" create="0" edit="0" delete="0"
                  decoration-danger="state == 'error'" decoration-muted="state == 'skipped'">
                <field name="create_date" string="Thời điểm"/>
                <field name="rule_id"/>
                <field name="partner_id"/>
                <field name="visit_id"/>
                <field name="message_id" optional="show"/>
                <field name="message_state" optional="show"/>
                <field name="activity_id" optional="hide"/>
                <field name="note" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"
                       decoration-danger="state == 'error'"/>
            </tree>
        </field>
    </record>
    <record id="view_dmag_journey_execution_form" model="ir.ui.view">
        <field name="name">dmag.journey.execution.form</field>
        <field name="model">dmag.journey.execution</field>
        <field name="arch" type="xml">
            <form string="Điểm chạm" create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="rule_id"/>
                            <field name="stage"/>
                            <field name="trigger"/>
                            <field name="dedupe_key"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="visit_id"/>
                            <field name="message_id"/>
                            <field name="message_state"/>
                            <field name="activity_id"/>
                            <field name="nps_response_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_dmag_journey_execution_search" model="ir.ui.view">
        <field name="name">dmag.journey.execution.search</field>
        <field name="model">dmag.journey.execution</field>
        <field name="arch" type="xml">
            <search>
                <field name="rule_id"/>
                <field name="partner_id"/>
                <field name="visit_id"/>
                <filter name="error" string="Lỗi" domain="[('state', '=', 'error')]"/>
                <filter name="skipped" string="Bỏ qua" domain="[('state', '=', 'skipped')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_rule" string="Luật" context="{'group_by': 'rule_id'}"/>
                    <filter name="group_stage" string="Giai đoạn" context="{'group_by': 'stage'}"/>
                    <filter name="group_day" string="Ngày" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_dmag_journey_execution" model="ir.actions.act_window">
        <field name="name">Nhật ký điểm chạm</field>
        <field name="res_model">dmag.journey.execution</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
