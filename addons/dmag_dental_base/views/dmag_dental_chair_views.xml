<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dmag_chair_tree" model="ir.ui.view">
        <field name="name">dmag.dental.chair.tree</field>
        <field name="model">dmag.dental.chair</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="room"/>
                <field name="note"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>
    <record id="action_dmag_chair" model="ir.actions.act_window">
        <field name="name">Ghế nha</field>
        <field name="res_model">dmag.dental.chair</field>
        <field name="view_mode">tree</field>
        <field name="context">{'active_test': False}</field>
    </record>
    <menuitem id="menu_dmag_chair" name="Ghế nha" parent="menu_dmag_config_clinic"
              action="action_dmag_chair" sequence="20"/>
</odoo>
