<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_dmag" model="ir.ui.view">
        <field name="name">res.company.form.dmag</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Nha khoa" name="dmag_dental">
                    <group>
                        <group string="Pháp lý cơ sở KCB">
                            <field name="dmag_facility_code"/>
                            <field name="dmag_license_number"/>
                            <field name="dmag_license_date"/>
                            <field name="dmag_professional_director"/>
                        </group>
                        <group string="Kiểm soát">
                            <field name="dmag_max_discount"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
