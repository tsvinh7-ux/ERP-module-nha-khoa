<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_dmag_dental" model="ir.module.category">
        <field name="name">Nha khoa DMAG</field>
        <field name="description">Phân quyền vận hành phòng khám nha khoa</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_dmag_receptionist" model="res.groups">
        <field name="name">Lễ tân / Thu ngân</field>
        <field name="category_id" ref="module_category_dmag_dental"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('base.group_partner_manager'))]"/>
        <field name="comment">Đặt lịch, tiếp đón, điều phối ghế, thu tiền. Xem thông tin hành chính và cảnh báo y khoa, không sửa bệnh án.</field>
    </record>

    <record id="group_dmag_assistant" model="res.groups">
        <field name="name">Phụ tá / Điều dưỡng</field>
        <field name="category_id" ref="module_category_dmag_dental"/>
        <field name="implied_ids" eval="[(4, ref('group_dmag_receptionist'))]"/>
        <field name="comment">Ghi nhận vật tư, ảnh, điểm đau; xem bệnh án.</field>
    </record>

    <record id="group_dmag_doctor" model="res.groups">
        <field name="name">Bác sĩ</field>
        <field name="category_id" ref="module_category_dmag_dental"/>
        <field name="implied_ids" eval="[(4, ref('group_dmag_assistant'))]"/>
        <field name="comment">Khám, ghi bệnh án, sơ đồ răng, lập kế hoạch điều trị, ký bệnh án.</field>
    </record>

    <record id="group_dmag_manager" model="res.groups">
        <field name="name">Quản lý phòng khám</field>
        <field name="category_id" ref="module_category_dmag_dental"/>
        <field name="implied_ids" eval="[(4, ref('group_dmag_doctor'))]"/>
        <field name="comment">Vận hành phòng khám: cấu hình ghế, bác sĩ, dịch vụ, danh mục; sửa thông tin hành chính bệnh nhân.</field>
    </record>

    <record id="group_dmag_director" model="res.groups">
        <field name="name">Giám đốc / Quản lý cấp cao</field>
        <field name="category_id" ref="module_category_dmag_dental"/>
        <field name="implied_ids" eval="[(4, ref('group_dmag_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Duy nhất nhóm này được sửa / hủy chứng từ đã ghi nhận, sửa giá, duyệt giảm giá vượt hạn mức, mở bổ sung bệnh án đã ký. Mọi thao tác được ghi vết.</field>
    </record>

    <record id="rule_dmag_chair_company" model="ir.rule">
        <field name="name">Ghế nha: theo phòng khám</field>
        <field name="model_id" ref="model_dmag_dental_chair"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_dmag_practitioner_company" model="ir.rule">
        <field name="name">Nhân sự lâm sàng: theo phòng khám</field>
        <field name="model_id" ref="model_dmag_dental_practitioner"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="ir_cron_dmag_license_expiry" model="ir.cron">
        <field name="name">Nha khoa: nhắc gia hạn giấy phép hành nghề</field>
        <field name="model_id" ref="model_dmag_dental_practitioner"/>
        <field name="state">code</field>
        <field name="code">model._cron_notify_license_expiry()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
    </record>

    <record id="rule_dmag_clinic_schedule_company" model="ir.rule">
        <field name="name">Lịch làm việc: theo phòng khám</field>
        <field name="model_id" ref="model_dmag_clinic_schedule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_dmag_clinic_schedule_line_company" model="ir.rule">
        <field name="name">Ca làm việc: theo phòng khám</field>
        <field name="model_id" ref="model_dmag_clinic_schedule_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_dmag_clinic_closure_company" model="ir.rule">
        <field name="name">Ngày nghỉ phòng khám: theo phòng khám</field>
        <field name="model_id" ref="model_dmag_clinic_closure"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
