<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dmag_visit_form_loyalty" model="ir.ui.view">
        <field name="name">dmag.dental.visit.form.loyalty</field>
        <field name="model">dmag.dental.visit</field>
        <field name="inherit_id" ref="dmag_dental_clinic.view_dmag_visit_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_create_invoice']" position="before">
                <button name="action_open_dmag_loyalty_wizard" type="object" string="Ưu đãi thành viên"
                        invisible="state in ('cancel', 'no_show') or payment_status != 'to_invoice'"/>
            </xpath>
            <xpath expr="//field[@name='is_new_patient']" position="after">
                <field name="dmag_patient_tier_id"/>
            </xpath>
            <xpath expr="//page[@name='journey']" position="inside">
                <group string="Ưu đãi thành viên" invisible="not dmag_voucher_ids and not dmag_care_usage_ids">
                    <field name="dmag_voucher_ids" readonly="1" nolabel="1" colspan="2">
                        <tree>
                            <field name="name"/>
                            <field name="used_amount"/>
                            <field name="currency_id" column_invisible="1"/>
                        </tree>
                    </field>
                    <field name="dmag_care_usage_ids" readonly="1" nolabel="1" colspan="2">
                        <tree>
                            <field name="subscription_id"/>
                            <field name="product_id"/>
                            <field name="original_price"/>
                        </tree>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
