<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dmag_loyalty_voucher_tree" model="ir.ui.view">
        <field name="name">dmag.loyalty.voucher.tree</field>
        <field name="model">dmag.loyalty.voucher</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state in ('used', 'expired', 'cancel')" decoration-warning="state == 'to_approve'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="origin"/>
                <field name="value_type"/>
                <field name="value"/>
                <field name="points_cost" optional="show"/>
                <field name="valid_from"/>
                <field name="valid_to"/>
                <field name="used_visit_id" optional="show"/>
                <field name="used_amount" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-warning="state == 'to_approve'"/>
                <field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>
    <record id="view_dmag_loyalty_voucher_form" model="ir.ui.view">
        <field name="name">dmag.loyalty.voucher.form</field>
        <field name="model">dmag.loyalty.voucher</field>
        <field name="arch" type="xml">
            <form string="Voucher">
                <header>
                    <button name="action_approve" type="object" string="Duyệt" class="btn-primary" invisible="state != 'to_approve'" groups="dmag_dental_base.group_dmag_manager"/>
                    <button name="action_reject" type="object" string="Từ chối" invisible="state != 'to_approve'" groups="dmag_dental_base.group_dmag_manager"/>
                    <button name="action_cancel" type="object" string="Hủy voucher" invisible="state != 'active'" groups="dmag_dental_base.group_dmag_director" confirm="Hủy voucher và hoàn điểm (nếu đổi từ điểm)?"/>
                    <field name="state" widget="statusbar" statusbar_visible="to_approve,active,used"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="id"/>
                            <field name="origin" readonly="id"/>
                            <field name="value_type" readonly="id"/>
                            <field name="value" readonly="id"/>
                            <field name="max_amount" invisible="value_type != 'percent'" readonly="id"/>
                            <field name="points_cost" invisible="not points_cost"/>
                        </group>
                        <group>
                            <field name="valid_from" readonly="id"/>
                            <field name="valid_to" readonly="id"/>
                            <field name="approved_by_id"/>
                            <field name="used_visit_id"/>
                            <field name="used_date"/>
                            <field name="used_amount"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Ghi chú"/>
                    <div class="text-muted small mt-2">Voucher có hiệu lực tối thiểu 7 ngày, dùng một lần và hiển thị minh bạch trong tài khoản bệnh nhân.</div>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_dmag_loyalty_voucher_search" model="ir.ui.view">
        <field name="name">dmag.loyalty.voucher.search</field>
        <field name="model">dmag.loyalty.voucher</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="to_approve" string="Chờ duyệt" domain="[('state', '=', 'to_approve')]"/>
                <filter name="active_v" string="Có hiệu lực" domain="[('state', '=', 'active')]"/>
                <filter name="used" string="Đã dùng" domain="[('state', '=', 'used')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_state" string="Trạng thái" context="{'group_by': 'state'}"/>
                    <filter name="group_origin" string="Nguồn" context="{'group_by': 'origin'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_dmag_loyalty_voucher" model="ir.actions.act_window">
        <field name="name">Voucher</field>
        <field name="res_model">dmag.loyalty.voucher</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
