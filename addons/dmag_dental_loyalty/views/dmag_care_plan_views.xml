<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dmag_care_plan_tree" model="ir.ui.view">
        <field name="name">dmag.care.plan.tree</field>
        <field name="model">dmag.care.plan</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="price"/>
                <field name="duration_months"/>
                <field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>
    <record id="view_dmag_care_plan_form" model="ir.ui.view">
        <field name="name">dmag.care.plan.form</field>
        <field name="model">dmag.care.plan</field>
        <field name="arch" type="xml">
            <form string="Gói chăm sóc định kỳ">
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Ví dụ: Gói chăm sóc năm"/></h1></div>
                    <group>
                        <group>
                            <field name="price"/>
                            <field name="duration_months"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="product_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <tree editable="bottom">
                            <field name="product_id"/>
                            <field name="quantity"/>
                        </tree>
                    </field>
                    <field name="description" placeholder="Mô tả quyền lợi cho bệnh nhân"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_dmag_care_plan" model="ir.actions.act_window">
        <field name="name">Gói chăm sóc định kỳ</field>
        <field name="res_model">dmag.care.plan</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_dmag_care_subscription_tree" model="ir.ui.view">
        <field name="name">dmag.care.subscription.tree</field>
        <field name="model">dmag.care.subscription</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state in ('expired', 'cancel')">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="price"/>
                <field name="amount_due"/>
                <field name="state" widget="badge" decoration-success="state == 'active'"/>
                <field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>
    <record id="view_dmag_care_subscription_form" model="ir.ui.view">
        <field name="name">dmag.care.subscription.form</field>
        <field name="model">dmag.care.subscription</field>
        <field name="arch" type="xml">
            <form string="Thuê bao gói chăm sóc">
                <header>
                    <button name="action_activate" type="object" string="Kích hoạt &amp; lập hóa đơn" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Hủy" invisible="state not in ('draft', 'active')" groups="dmag_dental_base.group_dmag_director"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,expired"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="plan_id" readonly="state != 'draft'"/>
                            <field name="price"/>
                            <field name="amount_due" invisible="state == 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="start_date" readonly="state != 'draft'"/>
                            <field name="end_date"/>
                            <field name="sale_order_id" groups="sales_team.group_sale_salesman"/>
                            <field name="invoice_ids" widget="many2many_tags" groups="account.group_account_invoice"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Quyền lợi" name="entitlements">
                            <field name="entitlement_ids" readonly="1">
                                <tree>
                                    <field name="product_id"/>
                                    <field name="qty_total"/>
                                    <field name="qty_used"/>
                                    <field name="qty_remaining" decoration-danger="qty_remaining &lt;= 0"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Lịch sử sử dụng" name="usage">
                            <field name="usage_ids" readonly="1">
                                <tree>
                                    <field name="date"/>
                                    <field name="visit_id"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="original_price"/>
                                    <field name="user_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_dmag_care_subscription_search" model="ir.ui.view">
        <field name="name">dmag.care.subscription.search</field>
        <field name="model">dmag.care.subscription</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <filter name="active_sub" string="Đang hiệu lực" domain="[('state', '=', 'active')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_plan" string="Gói" context="{'group_by': 'plan_id'}"/>
                    <filter name="group_state" string="Trạng thái" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_dmag_care_subscription" model="ir.actions.act_window">
        <field name="name">Thuê bao gói chăm sóc</field>
        <field name="res_model">dmag.care.subscription</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active_sub': 1}</field>
    </record>
</odoo>
