<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_dmag_warranty_card" model="ir.sequence">
            <field name="name">Thẻ bảo hành</field>
            <field name="code">dmag.warranty.card</field>
            <field name="prefix">BH%(y)s</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_dmag_warranty_claim" model="ir.sequence">
            <field name="name">Yêu cầu bảo hành</field>
            <field name="code">dmag.warranty.claim</field>
            <field name="prefix">YCBH%(y)s</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
    <record id="ir_cron_dmag_warranty_expiry" model="ir.cron">
        <field name="name">Nha khoa: thẻ bảo hành hết hạn / sắp hết hạn</field>
        <field name="model_id" ref="model_dmag_warranty_card"/>
        <field name="state">code</field>
        <field name="code">model._cron_warranty_expiry(30)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
    </record>
</odoo>
