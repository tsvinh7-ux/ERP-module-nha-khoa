<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_dmag_warranty_card_company" model="ir.rule">
        <field name="name">Thẻ bảo hành: theo phòng khám</field>
        <field name="model_id" ref="model_dmag_warranty_card"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_dmag_warranty_claim_company" model="ir.rule">
        <field name="name">Yêu cầu bảo hành: theo phòng khám</field>
        <field name="model_id" ref="model_dmag_warranty_claim"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
