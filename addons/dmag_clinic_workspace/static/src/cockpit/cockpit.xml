<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dmag_clinic_workspace.OwnerCockpit">
        <div class="dmag-ws dmag-cockpit">
            <header class="dmag-ws-header">
                <div class="dmag-ws-title">
                    <div class="dmag-brand-mark">D</div>
                    <div>
                        <h1>Buồng lái chủ phòng khám</h1>
                        <span class="dmag-ws-sub" t-if="state.data">Kỳ <t t-esc="state.data.period.from"/> → <t t-esc="state.data.period.to"/></span>
                    </div>
                </div>
                <div class="dmag-seg">
                    <button t-att-class="state.range === 'week' ? 'is-on' : ''" t-on-click="() => this.setRange('week')">7 ngày</button>
                    <button t-att-class="state.range === 'month' ? 'is-on' : ''" t-on-click="() => this.setRange('month')">Tháng này</button>
                    <button t-att-class="state.range === 'quarter' ? 'is-on' : ''" t-on-click="() => this.setRange('quarter')">Quý này</button>
                </div>
            </header>
            <t t-if="state.data">
                <t t-set="k" t-value="state.data.kpis"/>
                <section class="dmag-hero-row">
                    <div class="dmag-hero is-primary">
                        <span class="dmag-hero-label">Doanh thu dịch vụ</span>
                        <span class="dmag-hero-value" t-esc="formatMoney(k.revenue)"/>
                        <span class="dmag-hero-sub"><t t-esc="k.visits_done"/> lượt khám · TB <t t-esc="formatMoney(k.avg_ticket)"/>/lượt</span>
                    </div>
                    <div class="dmag-hero">
                        <span class="dmag-hero-label">Thực thu</span>
                        <span class="dmag-hero-value" t-esc="formatMoney(k.collected)"/>
                        <span class="dmag-hero-sub">Công nợ còn: <b t-esc="formatMoney(k.receivable)"/></span>
                    </div>
                    <div class="dmag-hero">
                        <span class="dmag-hero-label">Khách mới</span>
                        <span class="dmag-hero-value" t-esc="k.new_patients"/>
                        <span class="dmag-hero-sub">Không đến: <t t-esc="pct(k.no_show_rate)"/></span>
                    </div>
                    <div class="dmag-hero" t-if="compliance">
                        <t t-set="c" t-value="compliance"/>
                        <span class="dmag-hero-label">Hồ sơ pháp chế – sẵn sàng thanh tra</span>
                        <span t-att-class="'dmag-hero-value' + ((c.expired + c.missing) ? ' is-bad' : '')"><t t-esc="c.expired + c.missing"/> cần xử lý</span>
                        <span class="dmag-hero-sub"><t t-esc="c.expired"/> hết hạn · <t t-esc="c.missing"/> còn thiếu · <t t-esc="c.expiring"/> sắp hết hạn</span>
                    </div>
                </section>

                <section class="dmag-scorecards">
                    <div t-foreach="scorecards" t-as="card" t-key="card.key" class="dmag-scorecard">
                        <div class="dmag-scorecard-top">
                            <span class="dmag-scorecard-label" t-esc="card.label"/>
                            <span t-if="card.nodata" class="dmag-status is-muted">Chưa có số liệu</span>
                            <span t-else="" t-att-class="'dmag-status ' + (card.ok ? 'is-good' : 'is-warn')">
                                <i t-att-class="'fa ' + (card.ok ? 'fa-check-circle' : 'fa-exclamation-triangle')" t-att-title="card.ok ? 'Đạt' : 'Cần chú ý'"/>
                                <t t-esc="card.ok ? 'Đạt' : 'Cần chú ý'"/>
                            </span>
                        </div>
                        <div class="dmag-scorecard-value" t-esc="card.value"/>
                        <div class="dmag-meter"><div t-att-style="'width:' + (card.nodata ? 0 : Math.min(100, Math.max(0, card.ratio * 100))) + '%'"/></div>
                        <div class="dmag-scorecard-target">Mục tiêu DMAG <t t-esc="card.target"/></div>
                    </div>
                </section>

                <section class="dmag-cockpit-grid">
                    <div class="dmag-panel dmag-chart-panel">
                        <div class="dmag-panel-title">Doanh thu dịch vụ theo ngày</div>
                        <t t-set="ch" t-value="chart"/>
                        <svg t-att-viewBox="'0 0 ' + ch.W + ' ' + ch.H" class="dmag-bars" role="img" aria-label="Doanh thu theo ngày">
                            <t t-foreach="ch.ticks" t-as="tk" t-key="tk_index">
                                <line t-att-x1="ch.pad.l" t-att-x2="ch.W - ch.pad.r" t-att-y1="tk.y" t-att-y2="tk.y" class="dmag-grid"/>
                                <text t-att-x="ch.pad.l - 6" t-att-y="tk.y + 4" text-anchor="end" class="dmag-axis" t-esc="tk.label"/>
                            </t>
                            <t t-foreach="ch.bars" t-as="b" t-key="b.i">
                                <g t-on-mouseenter="() => this.state.hover = b" t-on-mouseleave="() => this.state.hover = null">
                                    <rect t-att-x="b.x - 3" t-att-y="ch.pad.t" t-att-width="b.w + 6" t-att-height="ch.base - ch.pad.t" fill="transparent"/>
                                    <rect t-if="b.h > 0" t-att-x="b.x" t-att-y="b.top" t-att-width="b.w" t-att-height="b.h" rx="4" class="dmag-bar"/>
                                </g>
                                <text t-if="b.showLabel" t-att-x="b.x + b.w / 2" t-att-y="ch.H - 8" text-anchor="middle" class="dmag-axis" t-esc="b.label"/>
                            </t>
                            <line t-att-x1="ch.pad.l" t-att-x2="ch.W - ch.pad.r" t-att-y1="ch.base" t-att-y2="ch.base" class="dmag-baseline"/>
                        </svg>
                        <div class="dmag-tooltip-line">
                            <t t-if="state.hover">Ngày <b t-esc="state.hover.label"/>: <b t-esc="formatMoney(state.hover.value)"/></t>
                            <t t-else="">Rê chuột / chạm vào cột để xem số liệu</t>
                        </div>
                    </div>
                    <div class="dmag-panel">
                        <div class="dmag-panel-title">Doanh thu theo bác sĩ</div>
                        <t t-set="mx" t-value="maxOf(state.data.by_doctor, 'revenue')"/>
                        <div t-if="!state.data.by_doctor.length" class="text-muted small">Chưa có số liệu</div>
                        <div t-foreach="state.data.by_doctor" t-as="d" t-key="d.name" class="dmag-hbar">
                            <div class="dmag-hbar-head"><span t-esc="d.name"/><b t-esc="compact(d.revenue)"/></div>
                            <div class="dmag-hbar-track" t-att-title="formatMoney(d.revenue) + ' · ' + d.count + ' thủ thuật'"><div t-att-style="'width:' + (100 * d.revenue / mx) + '%'"/></div>
                        </div>
                    </div>
                    <div class="dmag-panel">
                        <div class="dmag-panel-title">Theo nhóm dịch vụ</div>
                        <t t-set="mc" t-value="maxOf(state.data.by_category, 'revenue')"/>
                        <div t-if="!state.data.by_category.length" class="text-muted small">Chưa có số liệu</div>
                        <div t-foreach="state.data.by_category" t-as="c" t-key="c.name" class="dmag-hbar">
                            <div class="dmag-hbar-head"><span t-esc="c.name"/><b t-esc="compact(c.revenue)"/></div>
                            <div class="dmag-hbar-track" t-att-title="formatMoney(c.revenue)"><div t-att-style="'width:' + (100 * c.revenue / mc) + '%'"/></div>
                        </div>
                    </div>
                    <div class="dmag-panel">
                        <div class="dmag-panel-title">Khách mới theo nguồn</div>
                        <t t-set="ms" t-value="maxOf(state.data.sources, 'count')"/>
                        <div t-if="!state.data.sources.length" class="text-muted small">Chưa có số liệu</div>
                        <div t-foreach="state.data.sources" t-as="s" t-key="s.name" class="dmag-hbar">
                            <div class="dmag-hbar-head"><span t-esc="s.name"/><b t-esc="s.count"/></div>
                            <div class="dmag-hbar-track"><div t-att-style="'width:' + (100 * s.count / ms) + '%'"/></div>
                        </div>
                    </div>
                    <div class="dmag-panel" t-if="compliance and compliance.red.length">
                        <div class="dmag-panel-title">Cần xử lý ngay (pháp chế)</div>
                        <div t-foreach="compliance.red" t-as="it" t-key="it_index" class="dmag-entry">
                            <i class="fa fa-exclamation-triangle text-danger me-2" title="Cần xử lý"/>
                            <span class="flex-grow-1"><b t-esc="it.type or it.kind"/> <span t-esc="it.name"/></span>
                            <span class="small text-muted"><t t-if="it.kind === 'missing'">Chưa có</t><t t-elif="it.expiry_date">Hạn <t t-esc="it.expiry_date"/></t></span>
                        </div>
                    </div>
                </section>
            </t>
        </div>
    </t>
</templates>
