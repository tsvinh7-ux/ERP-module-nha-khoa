<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lễ tân / bác sĩ KHÔNG có quyền Bán hàng / Kế toán: đơn, hóa đơn, thanh toán được tạo qua
         nghiệp vụ nha khoa bằng quyền hệ thống (tạo được – không sửa). Giám đốc mới sửa / hủy chứng từ. -->
    <record id="dmag_dental_base.group_dmag_director" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_manager')), (4, ref('account.group_account_invoice'))]"/>
    </record>
    <record id="rule_dmag_visit_company" model="ir.rule">
        <field name="name">Lượt khám: theo phòng khám</field>
        <field name="model_id" ref="model_dmag_dental_visit"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_dmag_plan_company" model="ir.rule">
        <field name="name">Kế hoạch điều trị: theo phòng khám</field>
        <field name="model_id" ref="model_dmag_treatment_plan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_dmag_chart_company" model="ir.rule">
        <field name="name">Sơ đồ răng: theo phòng khám</field>
        <field name="model_id" ref="model_dmag_dental_chart_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
