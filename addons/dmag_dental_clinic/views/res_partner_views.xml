<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_dmag_clinic" model="ir.ui.view">
        <field name="name">res.partner.form.dmag.clinic</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_dental_visits" type="object" class="oe_stat_button" icon="fa-calendar-check-o"
                        invisible="not is_patient" groups="dmag_dental_base.group_dmag_receptionist">
                    <field name="dental_visit_count" widget="statinfo" string="Lượt khám"/>
                </button>
                <button name="action_open_dental_plans" type="object" class="oe_stat_button" icon="fa-list-ol"
                        invisible="not is_patient" groups="dmag_dental_base.group_dmag_receptionist">
                    <field name="dental_plan_count" widget="statinfo" string="Kế hoạch"/>
                </button>
                <button name="action_open_dental_chart" type="object" class="oe_stat_button" icon="fa-th"
                        invisible="not is_patient" groups="dmag_dental_base.group_dmag_receptionist" string="Sơ đồ răng"/>
            </xpath>
        </field>
    </record>
</odoo>
