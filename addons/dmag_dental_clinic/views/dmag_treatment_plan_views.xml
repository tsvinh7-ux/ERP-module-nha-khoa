<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dmag_treatment_option_form" model="ir.ui.view">
        <field name="name">dmag.treatment.option.form</field>
        <field name="model">dmag.treatment.option</field>
        <field name="arch" type="xml">
            <form string="Phương án điều trị">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="is_recommended"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="amount_total"/>
                            <field name="deposit_amount"/>
                            <field name="installment_months"/>
                            <field name="monthly_amount" invisible="not installment_months"/>
                            <field name="estimated_visits"/>
                        </group>
                    </group>
                    <field name="summary" placeholder="Ưu điểm, nhược điểm, độ bền, thời gian… giải thích theo y đức"/>
                    <field name="line_ids">
                        <tree editable="bottom">
                            <field name="phase"/>
                            <field name="product_id"/>
                            <field name="tooth_ids" widget="many2many_tags"/>
                            <field name="surface_ids" widget="many2many_tags" optional="hide"/>
                            <field name="quantity"/>
                            <field name="price_unit"/>
                            <field name="discount" optional="show"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="price_subtotal" sum="Tổng"/>
                            <field name="state" widget="badge" decoration-success="state == 'done'"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dmag_treatment_plan_form" model="ir.ui.view">
        <field name="name">dmag.treatment.plan.form</field>
        <field name="model">dmag.treatment.plan</field>
        <field name="arch" type="xml">
            <form string="Kế hoạch điều trị">
                <header>
                    <button name="action_present" type="object" string="Đã tư vấn cho bệnh nhân" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_second_opinion" type="object" string="Duyệt chỉ định (BS thứ hai)"
                            invisible="not second_opinion_required or second_opinion_by_id or state not in ('draft', 'presented')"
                            groups="dmag_dental_base.group_dmag_doctor"/>
                    <button name="%(dmag_dental_clinic.action_report_treatment_plan)d" type="action" string="In bản tóm tắt" invisible="state == 'cancel'"/>
                    <button name="action_reset_draft" type="object" string="Soạn lại" invisible="state not in ('presented', 'cancel') or sale_order_id"/>
                    <button name="action_cancel" type="object" string="Bệnh nhân từ chối / Hủy" invisible="state in ('done', 'cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,presented,accepted,in_progress,done"/>
                </header>
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="not second_opinion_required or second_opinion_by_id or state not in ('draft', 'presented')">
                    <i class="fa fa-shield me-1" title="Cầu chì y đức"/> Cầu chì y đức: kế hoạch có dịch vụ cần <b>bác sĩ thứ hai duyệt chỉ định</b> trước khi bệnh nhân ký.
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_sale_order" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not sale_order_id">
                            <div class="o_stat_info"><span class="o_stat_text">Hợp đồng</span></div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <field name="title" placeholder="Tiêu đề kế hoạch (ví dụ: Phục hình răng hàm dưới)"/>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id" readonly="state != 'draft'"/>
                            <field name="doctor_id"/>
                            <field name="visit_id" domain="[('patient_id', '=', patient_id)]"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="accepted_option_id" invisible="not accepted_option_id"/>
                            <field name="amount_accepted" invisible="not accepted_option_id"/>
                            <field name="progress" widget="progressbar" invisible="not accepted_option_id"/>
                            <field name="sale_order_id" invisible="not sale_order_id"/>
                            <field name="second_opinion_required" invisible="1"/>
                            <field name="second_opinion_by_id" invisible="not second_opinion_by_id"/>
                            <field name="second_opinion_date" invisible="not second_opinion_by_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Phương án" name="options">
                            <field name="option_ids" readonly="state not in ('draft', 'presented')">
                                <tree decoration-success="is_accepted" decoration-bf="is_recommended">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="is_recommended" widget="boolean_toggle"/>
                                    <field name="estimated_visits"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="amount_total"/>
                                    <field name="installment_months"/>
                                    <field name="monthly_amount"/>
                                    <field name="is_accepted" column_invisible="1"/>
                                    <button name="action_accept" type="object" string="Bệnh nhân chọn" class="btn-primary btn-sm"
                                            invisible="parent.state not in ('draft', 'presented')"
                                            confirm="Xác nhận bệnh nhân đồng ý phương án này? Hệ thống sẽ lập hợp đồng điều trị."/>
                                </tree>
                            </field>
                        </page>
                        <page string="Ghi chú tư vấn" name="note">
                            <field name="note"/>
                            <group><field name="reject_reason" invisible="state != 'cancel'"/></group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_dmag_treatment_plan_tree" model="ir.ui.view">
        <field name="name">dmag.treatment.plan.tree</field>
        <field name="model">dmag.treatment.plan</field>
        <field name="arch" type="xml">
            <tree>
                <field name="date"/>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="title"/>
                <field name="doctor_id"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount_accepted" sum="Tổng"/>
                <field name="progress" widget="progressbar"/>
                <field name="state" widget="badge" decoration-info="state in ('draft', 'presented')"
                       decoration-success="state in ('accepted', 'in_progress', 'done')" decoration-muted="state == 'cancel'"/>
            </tree>
        </field>
    </record>

    <record id="view_dmag_treatment_plan_search" model="ir.ui.view">
        <field name="name">dmag.treatment.plan.search</field>
        <field name="model">dmag.treatment.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="patient_id" context="{'dmag_patient_search': True}"/>
                <field name="name"/>
                <field name="doctor_id"/>
                <filter string="Chờ bệnh nhân quyết định" name="filter_pending" domain="[('state', 'in', ('draft', 'presented'))]"/>
                <filter string="Đang điều trị" name="filter_active" domain="[('state', 'in', ('accepted', 'in_progress'))]"/>
                <filter string="Từ chối" name="filter_cancel" domain="[('state', '=', 'cancel')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Bác sĩ" name="group_doctor" context="{'group_by': 'doctor_id'}"/>
                    <filter string="Trạng thái" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dmag_treatment_plan" model="ir.actions.act_window">
        <field name="name">Kế hoạch điều trị</field>
        <field name="res_model">dmag.treatment.plan</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
