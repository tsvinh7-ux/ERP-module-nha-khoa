<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_dmag_clinic" model="ir.ui.view">
        <field name="name">product.template.form.dmag.clinic</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="dmag_dental_base.product_template_form_dmag"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='dental_requires_tooth']" position="after">
                <field name="dental_result_condition_id"/>
            </xpath>
        </field>
    </record>
</odoo>
