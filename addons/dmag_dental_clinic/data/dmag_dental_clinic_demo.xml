    <record id="demo_visit_1" model="dmag.dental.visit">
        <field name="patient_id" ref="dmag_dental_base.demo_patient_1"/>
        <field name="doctor_id" ref="dmag_dental_base.demo_doctor_director"/>
        <field name="scheduled_start" eval="(DateTime.today() + relativedelta(hours=1, minutes=30)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="reason">Cạo vôi định kỳ 6 tháng</field>
        <field name="service_ids" eval="[(6, 0, [ref('dmag_dental_base.demo_svc_scaling')])]"/>
        <field name="state">done</field>
        <field name="chair_id" ref="dmag_dental_base.demo_chair_1"/>
        <field name="checkin_time" eval="(DateTime.today() + relativedelta(hours=1, minutes=18)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="chair_time" eval="(DateTime.today() + relativedelta(hours=1, minutes=33)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="done_time" eval="(DateTime.today() + relativedelta(hours=1, minutes=65)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="chief_complaint">Tái khám định kỳ, không đau.</field>
        <field name="examination">Cao răng độ 1 hai hàm, lợi viêm nhẹ vùng răng cửa dưới.</field>
        <field name="assessment">Viêm lợi mạn do cao răng.</field>
        <field name="treatment_note">Cạo vôi, đánh bóng hai hàm.</field>
        <field name="advice">Chải răng 2 lần/ngày, dùng chỉ nha khoa. Tái khám sau 6 tháng.</field>
        <field name="pain_score">1</field>
    </record>
