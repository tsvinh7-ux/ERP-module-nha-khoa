<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_dmag_visit" model="ir.sequence">
        <field name="name">Lượt khám nha khoa</field>
        <field name="code">dmag.dental.visit</field>
        <field name="prefix">LK%(y)s%(month)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_dmag_treatment_plan" model="ir.sequence">
        <field name="name">Kế hoạch điều trị</field>
        <field name="code">dmag.treatment.plan</field>
        <field name="prefix">KH%(y)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
