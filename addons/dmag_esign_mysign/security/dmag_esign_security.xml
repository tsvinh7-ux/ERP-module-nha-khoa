        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_dmag_esign_log_company" model="ir.rule">
        <field name="name">Nhật ký ký số: theo phòng khám</field>
        <field name="model_id" ref="model_dmag_esign_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
