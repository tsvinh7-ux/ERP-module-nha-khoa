<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dmag_commission_statement_wizard_form" model="ir.ui.view">
        <field name="name">dmag.commission.statement.wizard.form</field>
        <field name="model">dmag.commission.statement.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="month"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Lập bảng kê" class="btn-primary"/>
                    <button special="cancel" string="Hủy"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_dmag_commission_statement_wizard" model="ir.actions.act_window">
        <field name="name">Lập bảng kê hoa hồng tháng</field>
        <field name="res_model">dmag.commission.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
