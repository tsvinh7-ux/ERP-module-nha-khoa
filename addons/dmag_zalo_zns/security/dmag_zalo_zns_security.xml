<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_dmag_zns_template_company" model="ir.rule">
        <field name="name">Mẫu ZNS: theo phòng khám</field>
        <field name="model_id" ref="model_dmag_zns_template"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_dmag_zns_message_company" model="ir.rule">
        <field name="name">Tin ZNS: theo phòng khám</field>
        <field name="model_id" ref="model_dmag_zns_message"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_dmag_zns_webhook_company" model="ir.rule">
        <field name="name">Webhook Zalo: theo phòng khám</field>
        <field name="model_id" ref="model_dmag_zns_webhook_event"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
