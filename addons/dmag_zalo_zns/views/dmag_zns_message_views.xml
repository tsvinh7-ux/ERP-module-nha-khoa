<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dmag_zns_message_tree" model="ir.ui.view">
        <field name="name">dmag.zns.message.tree</field>
        <field name="model">dmag.zns.message</field>
        <field name="arch" type="xml">
            <tree string="Tin ZNS" create="0" edit="0" delete="0"
                  decoration-danger="state == 'failed'" decoration-muted="state in ('skipped', 'cancel')"
                  decoration-success="state == 'delivered'" decoration-info="state == 'queued'">
                <field name="create_date" string="Tạo lúc"/>
                <field name="partner_id"/>
                <field name="phone"/>
                <field name="template_id"/>
                <field name="origin" optional="show"/>
                <field name="next_try" optional="hide"/>
                <field name="sent_date" optional="show"/>
                <field name="attempt_count" optional="hide"/>
                <field name="error" optional="show"/>
                <field name="mode" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge" decoration-danger="state == 'failed'"
                       decoration-success="state in ('sent', 'delivered')" decoration-info="state == 'queued'"/>
            </tree>
        </field>
    </record>

    <record id="view_dmag_zns_message_form" model="ir.ui.view">
        <field name="name">dmag.zns.message.form</field>
        <field name="model">dmag.zns.message</field>
        <field name="arch" type="xml">
            <form string="Tin ZNS" create="0" edit="0" delete="0">
                <header>
                    <button name="action_retry" type="object" string="Gửi lại" class="btn-primary"
                            invisible="state not in ('failed', 'queued')" groups="dmag_dental_base.group_dmag_manager"/>
                    <button name="action_cancel" type="object" string="Hủy tin" invisible="state != 'queued'"
                            groups="dmag_dental_base.group_dmag_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="queued,sent,delivered"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_record" type="object" class="oe_stat_button" icon="fa-external-link"
                                string="Chứng từ nguồn" invisible="not res_id"/>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="phone"/>
                            <field name="template_id"/>
                            <field name="zalo_template_id"/>
                            <field name="transactional"/>
                            <field name="origin"/>
                            <field name="res_model" invisible="1"/>
                            <field name="res_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="tracking_id"/>
                            <field name="msg_id"/>
                            <field name="mode"/>
                            <field name="next_try"/>
                            <field name="expire_at"/>
                            <field name="attempt_count"/>
                            <field name="sent_date"/>
                            <field name="delivered_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Nội dung">
                        <field name="preview" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Lỗi" invisible="not error">
                        <field name="error_code"/>
                        <field name="error"/>
                    </group>
                    <notebook>
                        <page string="Tham số gửi" name="params">
                            <field name="params_json"/>
                        </page>
                        <page string="Phản hồi Zalo" name="response">
                            <field name="response_raw"/>
                        </page>
                        <page string="Đánh giá của khách" name="feedback" invisible="not feedback">
                            <field name="feedback"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dmag_zns_message_search" model="ir.ui.view">
        <field name="name">dmag.zns.message.search</field>
        <field name="model">dmag.zns.message</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="phone"/>
                <field name="template_id"/>
                <field name="tracking_id"/>
                <field name="msg_id"/>
                <filter name="queued" string="Chờ gửi" domain="[('state', '=', 'queued')]"/>
                <filter name="sent" string="Đã gửi / đã nhận" domain="[('state', 'in', ('sent', 'delivered'))]"/>
                <filter name="failed" string="Lỗi" domain="[('state', '=', 'failed')]"/>
                <filter name="skipped" string="Bỏ qua / hủy" domain="[('state', 'in', ('skipped', 'cancel'))]"/>
                <separator/>
                <filter name="today" string="Hôm nay"
                        domain="[('create_date', '&gt;=', (context_today()).strftime('%Y-%m-%d 00:00:00'))]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_state" string="Trạng thái" context="{'group_by': 'state'}"/>
                    <filter name="group_template" string="Mẫu" context="{'group_by': 'template_id'}"/>
                    <filter name="group_day" string="Ngày" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dmag_zns_message" model="ir.actions.act_window">
        <field name="name">Tin Zalo ZNS</field>
        <field name="res_model">dmag.zns.message</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">Chưa có tin ZNS nào</p>
        </field>
    </record>
</odoo>
