<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dmag_competency_assessment_tree" model="ir.ui.view">
        <field name="name">dmag.competency.assessment.tree</field>
        <field name="model">dmag.competency.assessment</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'draft'">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="name"/>
                <field name="score"/>
                <field name="p2_coefficient"/>
                <field name="assessor_id"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'"/>
            </tree>
        </field>
    </record>
    <record id="view_dmag_competency_assessment_form" model="ir.ui.view">
        <field name="name">dmag.competency.assessment.form</field>
        <field name="model">dmag.competency.assessment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_prefill" type="object" string="Nạp tiêu chí theo vị trí" invisible="state != 'draft'"/>
                    <button name="action_confirm" type="object" string="Chốt đánh giá" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_reset_draft" type="object" string="Mở lại" invisible="state != 'confirmed'"
                            groups="dmag_dental_base.group_dmag_director"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="profile_id"/>
                            <field name="name" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="assessor_id" readonly="state != 'draft'"/>
                            <field name="score"/>
                            <field name="p2_coefficient"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <tree editable="bottom">
                            <field name="competency_id"/>
                            <field name="weight"/>
                            <field name="score"/>
                            <field name="note"/>
                        </tree>
                    </field>
                    <field name="note" placeholder="Nhận xét chung…"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="action_dmag_competency_assessment" model="ir.actions.act_window">
        <field name="name">Đánh giá năng lực (P2)</field>
        <field name="res_model">dmag.competency.assessment</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_dmag_kpi_result_tree" model="ir.ui.view">
        <field name="name">dmag.kpi.result.tree</field>
        <field name="model">dmag.kpi.result</field>
        <field name="arch" type="xml">
            <tree editable="bottom" create="1">
                <field name="date_from"/>
                <field name="date_to" optional="hide"/>
                <field name="employee_id"/>
                <field name="kpi_id"/>
                <field name="weight"/>
                <field name="target"/>
                <field name="actual" readonly="is_auto"/>
                <field name="unit"/>
                <field name="achievement"/>
                <field name="data_source" optional="show"/>
                <field name="is_auto" optional="show"/>
                <field name="sheet_id" optional="hide"/>
            </tree>
        </field>
    </record>
    <record id="view_dmag_kpi_result_search" model="ir.ui.view">
        <field name="name">dmag.kpi.result.search</field>
        <field name="model">dmag.kpi.result</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="kpi_id"/>
                <filter name="manual" string="Nhập tay" domain="[('is_auto', '=', False)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_employee" string="Nhân viên" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_period" string="Kỳ" context="{'group_by': 'date_from'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_dmag_kpi_result" model="ir.actions.act_window">
        <field name="name">Kết quả KPI (P3)</field>
        <field name="res_model">dmag.kpi.result</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
