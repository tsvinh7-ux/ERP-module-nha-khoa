<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_dmag_ai_customer" model="ir.ui.view">
        <field name="name">res.company.form.dmag.ai.customer</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="dmag_ai_core.view_company_form_dmag_ai"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Trợ lý khách hàng – Zalo OA (AI-07)">
                    <group>
                        <field name="dmag_ai_zalo_enabled"/>
                        <field name="dmag_ai_zalo_reply_mode" widget="radio"/>
                        <field name="phone" string="Hotline trợ lý báo khách"/>
                    </group>
                    <group>
                        <field name="dmag_ai_clinic_hours"/>
                        <field name="dmag_ai_parking_info"/>
                        <field name="dmag_ai_payment_info"/>
                        <field name="dmag_ai_preparation_info"/>
                    </group>
                </group>
                <group string="Lịch hẹn &amp; chăm sóc (AI-08, AI-11, AI-18)">
                    <group>
                        <field name="dmag_ai_noshow_threshold" widget="percentage"/>
                        <field name="dmag_ai_chair_target" widget="percentage"/>
                    </group>
                    <group>
                        <field name="dmag_ai_followup_enabled"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
