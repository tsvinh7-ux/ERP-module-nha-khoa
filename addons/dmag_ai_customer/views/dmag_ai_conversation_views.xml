<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dmag_ai_conversation_tree" model="ir.ui.view">
        <field name="name">dmag.ai.conversation.tree</field>
        <field name="model">dmag.ai.conversation</field>
        <field name="arch" type="xml">
            <tree string="Hội thoại trợ lý AI" create="0" decoration-danger="state == 'handoff'" decoration-warning="pending_count &gt; 0"
                  decoration-muted="state == 'closed'">
                <field name="last_message_at" string="Tin cuối"/>
                <field name="name"/>
                <field name="channel"/>
                <field name="phone"/>
                <field name="partner_id"/>
                <field name="last_message_preview"/>
                <field name="state" widget="badge" decoration-danger="state == 'handoff'" decoration-info="state == 'bot'"
                       decoration-warning="state == 'human'"/>
                <field name="handoff_reason" optional="show"/>
                <field name="pending_count" optional="show"/>
                <field name="visit_count" string="Lịch giữ chỗ"/>
                <field name="estimated_cost_vnd" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_dmag_ai_conversation_form" model="ir.ui.view">
        <field name="name">dmag.ai.conversation.form</field>
        <field name="model">dmag.ai.conversation</field>
        <field name="arch" type="xml">
            <form string="Hội thoại trợ lý AI" create="0">
                <header>
                    <button name="action_take_over" type="object" string="Tiếp nhận" class="btn-primary" invisible="state in ('human', 'closed')"/>
                    <button name="action_back_to_bot" type="object" string="Trả về trợ lý AI" invisible="state == 'bot'"/>
                    <button name="action_close" type="object" string="Đóng hội thoại" invisible="state == 'closed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <div class="alert alert-danger" role="alert" invisible="state != 'handoff'">
                        <b>Cần nhân viên:</b> <field name="handoff_reason" readonly="1" class="d-inline"/> – <field name="handoff_summary" readonly="1" class="d-inline"/>
                    </div>
                    <group>
                        <group>
                            <field name="channel"/>
                            <field name="external_user_id"/>
                            <field name="phone"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="assigned_user_id"/>
                            <field name="handoff_at"/>
                            <field name="visit_ids" widget="many2many_tags"/>
                            <field name="estimated_cost_vnd"/>
                            <field name="cost_vnd"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tin nhắn" name="messages">
                            <field name="message_line_ids" readonly="1">
                                <tree decoration-info="role == 'bot'" decoration-success="role == 'staff'" decoration-muted="role == 'system'">
                                    <field name="create_date" string="Lúc"/>
                                    <field name="role"/>
                                    <field name="body"/>
                                    <field name="state"/>
                                    <field name="decision" optional="show"/>
                                    <field name="script_id" optional="show"/>
                                    <field name="match_confidence" widget="percentage" optional="hide"/>
                                    <field name="decision_note" optional="hide"/>
                                    <field name="visit_id"/>
                                    <field name="estimated_cost_vnd" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Phân loại phản hồi (AI-09)" name="feedback">
                            <field name="feedback_ids" readonly="1">
                                <tree>
                                    <field name="topic"/><field name="severity"/><field name="sentiment"/><field name="churn_risk"/>
                                    <field name="suggested_action"/><field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_dmag_ai_conversation_search" model="ir.ui.view">
        <field name="name">dmag.ai.conversation.search</field>
        <field name="model">dmag.ai.conversation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="phone"/><field name="partner_id"/>
                <filter name="attention" string="Cần nhân viên" domain="['|', ('state', 'in', ('handoff', 'human')), ('pending_count', '&gt;', 0)]"/>
                <filter name="bot" string="Trợ lý đang trả lời" domain="[('state', '=', 'bot')]"/>
                <filter name="booked" string="Có lịch giữ chỗ" domain="[('visit_ids', '!=', False)]"/>
                <separator/>
                <filter name="zalo" string="Zalo OA" domain="[('channel', '=', 'zalo')]"/>
                <filter name="sim" string="Mô phỏng" domain="[('channel', '=', 'simulator')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="g_state" string="Trạng thái" context="{'group_by': 'state'}"/>
                    <filter name="g_channel" string="Kênh" context="{'group_by': 'channel'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dmag_ai_conversation" model="ir.actions.act_window">
        <field name="name">Hội thoại trợ lý AI</field>
        <field name="res_model">dmag.ai.conversation</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_attention': 1}</field>
    </record>

    <record id="action_dmag_ai_inbox" model="ir.actions.client">
        <field name="name">Hộp thư trợ lý Zalo</field>
        <field name="tag">dmag_ai_inbox</field>
    </record>
    <record id="action_dmag_ai_zalo_simulator" model="ir.actions.client">
        <field name="name">Mô phỏng Zalo OA</field>
        <field name="tag">dmag_ai_zalo_simulator</field>
    </record>
</odoo>
