<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kho tri thức trợ lý -->
    <record id="view_dmag_ai_knowledge_tree" model="ir.ui.view">
        <field name="name">dmag.ai.knowledge.tree</field>
        <field name="model">dmag.ai.knowledge</field>
        <field name="arch" type="xml">
            <tree string="Kho tri thức trợ lý" decoration-warning="state == 'draft'" decoration-muted="not active">
                <field name="name"/>
                <field name="category" widget="badge"/>
                <field name="source_type"/>
                <field name="content" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-warning="state == 'draft'"/>
                <field name="approved_by_id" optional="hide"/>
                <field name="proposed_by_id" optional="hide"/>
                <field name="refreshed_at" optional="show"/>
                <field name="usage_count" string="Đã dùng" optional="show"/>
                <field name="valid_to" optional="hide"/>
                <field name="active" column_invisible="True"/>
                <button name="action_approve" type="object" string="Duyệt" icon="fa-check" invisible="state != 'draft'"
                        groups="dmag_dental_base.group_dmag_director"/>
            </tree>
        </field>
    </record>
    <record id="view_dmag_ai_knowledge_form" model="ir.ui.view">
        <field name="name">dmag.ai.knowledge.form</field>
        <field name="model">dmag.ai.knowledge</field>
        <field name="arch" type="xml">
            <form string="Mục tri thức">
                <header>
                    <button name="action_approve" type="object" string="Duyệt" class="btn-primary" invisible="state != 'draft'"
                            groups="dmag_dental_base.group_dmag_director"/>
                    <button name="action_reset_draft" type="object" string="Mở lại để sửa" invisible="state != 'approved' or auto_managed"
                            groups="dmag_dental_base.group_dmag_director"
                            confirm="Trợ lý ngừng dùng mục này đến khi được duyệt lại. Tiếp tục?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Đã duyệt" bg_color="text-bg-success" invisible="state != 'approved'"/>
                    <div class="alert alert-info mb-3" role="status" invisible="not auto_managed">
                        <i class="fa fa-refresh me-1" title="Tự cập nhật"/>Mục tự cập nhật từ dữ liệu gốc của Odoo – sửa ở bản ghi gốc
                        (bảng giá, lịch làm việc, lịch nghỉ luân phiên, thông tin phòng khám) rồi bấm "Nạp lại dữ liệu".
                    </div>
                    <div class="alert alert-warning mb-3" role="status" invisible="state != 'draft'">
                        Bản nháp – trợ lý <b>chưa</b> dùng nội dung này. Giám đốc bấm <b>Duyệt</b>.
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="state == 'approved'" placeholder="Ví dụ: Xuất hóa đơn VAT"/></h1></div>
                    <group>
                        <group>
                            <field name="category" readonly="state == 'approved'"/>
                            <field name="source_type" readonly="1"/>
                            <field name="tags" readonly="state == 'approved'"/>
                            <field name="auto_managed" invisible="1"/>
                        </group>
                        <group>
                            <field name="valid_from" readonly="state == 'approved'"/>
                            <field name="valid_to" readonly="state == 'approved'"/>
                            <field name="approved_by_id" invisible="not approved_by_id"/>
                            <field name="approval_note" invisible="not approval_note"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state == 'approved'"/>
                        </group>
                    </group>
                    <group string="Khách thường hỏi">
                        <field name="question_variants" nolabel="1" colspan="2" readonly="state == 'approved'" placeholder="Mỗi dòng một cách hỏi…"/>
                    </group>
                    <group string="Nội dung trợ lý được phép trả lời">
                        <field name="content" nolabel="1" colspan="2" readonly="state == 'approved'"/>
                    </group>
                    <group string="Nguồn">
                        <field name="document_id" invisible="not document_id"/>
                        <field name="script_id" invisible="not script_id"/>
                        <field name="gap_id" invisible="not gap_id"/>
                        <field name="proposed_by_id"/>
                        <field name="refreshed_at"/>
                        <field name="usage_count"/>
                        <field name="last_used_at"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_dmag_ai_knowledge_search" model="ir.ui.view">
        <field name="name">dmag.ai.knowledge.search</field>
        <field name="model">dmag.ai.knowledge</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="content"/>
                <field name="question_variants"/>
                <filter name="approved" string="Đã duyệt" domain="[('state', '=', 'approved')]"/>
                <filter name="draft" string="Chờ duyệt" domain="[('state', '=', 'draft')]"/>
                <separator/>
                <filter name="master" string="Dữ liệu gốc Odoo" domain="[('auto_managed', '=', True)]"/>
                <filter name="inbox" string="Từ hộp thư" domain="[('source_type', '=', 'inbox')]"/>
                <filter name="documents" string="Tài liệu" domain="[('source_type', '=', 'document')]"/>
                <separator/>
                <filter name="archived" string="Lưu trữ" domain="[('active', '=', False)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_source" string="Nguồn" context="{'group_by': 'source_type'}"/>
                    <filter name="group_category" string="Nhóm" context="{'group_by': 'category'}"/>
                    <filter name="group_state" string="Trạng thái" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_dmag_ai_knowledge" model="ir.actions.act_window">
        <field name="name">Kho tri thức trợ lý</field>
        <field name="res_model">dmag.ai.knowledge</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_group_source': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Kho tri thức trống</p>
            <p>Bấm "Nạp lại dữ liệu" trên màn hình Dữ liệu đã nạp để nạp bảng giá, lịch làm việc, lịch trực bác sĩ, thông tin
                phòng khám và kịch bản đã duyệt; tải tài liệu (TXT / Markdown / PDF) để nạp thêm.</p>
        </field>
    </record>

    <!-- Tài liệu -->
    <record id="view_dmag_ai_knowledge_document_tree" model="ir.ui.view">
        <field name="name">dmag.ai.knowledge.document.tree</field>
        <field name="model">dmag.ai.knowledge.document</field>
        <field name="arch" type="xml">
            <tree string="Tài liệu trợ lý">
                <field name="name"/>
                <field name="filename"/>
                <field name="chunk_count" string="Số đoạn"/>
                <field name="valid_to" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-warning="state == 'draft'"/>
            </tree>
        </field>
    </record>
    <record id="view_dmag_ai_knowledge_document_form" model="ir.ui.view">
        <field name="name">dmag.ai.knowledge.document.form</field>
        <field name="model">dmag.ai.knowledge.document</field>
        <field name="arch" type="xml">
            <form string="Tài liệu trợ lý">
                <header>
                    <button name="action_extract" type="object" string="Trích văn bản &amp; tách đoạn" class="btn-primary"
                            groups="dmag_dental_base.group_dmag_manager"/>
                    <button name="action_approve" type="object" string="Duyệt tài liệu" invisible="state != 'draft' or not chunk_count"
                            groups="dmag_dental_base.group_dmag_director"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_chunks" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="chunk_count" widget="statinfo" string="Đoạn"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" placeholder="Ví dụ: Cẩm nang khách hàng"/></h1></div>
                    <group>
                        <group>
                            <field name="datas" filename="filename"/>
                            <field name="filename" invisible="1"/>
                            <field name="valid_to"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Văn bản (trích từ tệp, hoặc dán trực tiếp)">
                        <field name="text" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="action_dmag_ai_knowledge_document" model="ir.actions.act_window">
        <field name="name">Tài liệu trợ lý</field>
        <field name="res_model">dmag.ai.knowledge.document</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Câu hỏi ngoài dữ liệu -->
    <record id="view_dmag_ai_kb_gap_tree" model="ir.ui.view">
        <field name="name">dmag.ai.kb.gap.tree</field>
        <field name="model">dmag.ai.kb.gap</field>
        <field name="arch" type="xml">
            <tree string="Câu hỏi ngoài dữ liệu" create="0" decoration-danger="state == 'open' and escalated_at"
                  decoration-warning="state == 'open'" decoration-success="state == 'learned'">
                <field name="create_date" string="Lúc"/>
                <field name="question"/>
                <field name="reason"/>
                <field name="conversation_id"/>
                <field name="assigned_user_id"/>
                <field name="escalated_at" optional="show"/>
                <field name="escalated_user_id" optional="hide"/>
                <field name="answer" optional="show"/>
                <field name="knowledge_id" optional="show"/>
                <field name="state" widget="badge" decoration-warning="state == 'open'" decoration-success="state in ('answered', 'learned')"/>
            </tree>
        </field>
    </record>
    <record id="view_dmag_ai_kb_gap_form" model="ir.ui.view">
        <field name="name">dmag.ai.kb.gap.form</field>
        <field name="model">dmag.ai.kb.gap</field>
        <field name="arch" type="xml">
            <form string="Câu hỏi ngoài dữ liệu" create="0">
                <header>
                    <button name="action_learn" type="object" string="Nạp vào kho tri thức" class="btn-primary"
                            invisible="state != 'answered' or knowledge_id"/>
                    <button name="action_dismiss" type="object" string="Bỏ qua" invisible="state not in ('open', 'answered')"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,answered,learned"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="question" readonly="1"/>
                            <field name="reason" readonly="1"/>
                            <field name="reason_note" readonly="1"/>
                            <field name="conversation_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="assigned_user_id"/>
                            <field name="assign_note" readonly="1"/>
                            <field name="notified_at" readonly="1"/>
                            <field name="escalated_at" readonly="1"/>
                            <field name="escalated_user_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Câu trả lời của nhân viên">
                        <field name="answer" nolabel="1" colspan="2"/>
                        <field name="answered_by_id" readonly="1"/>
                        <field name="knowledge_id" readonly="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="action_dmag_ai_kb_gap" model="ir.actions.act_window">
        <field name="name">Câu hỏi ngoài dữ liệu</field>
        <field name="res_model">dmag.ai.kb.gap</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_dmag_ai_kb_overview" model="ir.actions.client">
        <field name="name">Dữ liệu đã nạp</field>
        <field name="tag">dmag_ai_kb_overview</field>
    </record>
</odoo>
