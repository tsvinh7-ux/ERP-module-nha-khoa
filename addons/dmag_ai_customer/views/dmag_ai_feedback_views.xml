<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dmag_ai_feedback_tree" model="ir.ui.view">
        <field name="name">dmag.ai.feedback.tree</field>
        <field name="model">dmag.ai.feedback</field>
        <field name="arch" type="xml">
            <tree string="Phản hồi cần xử lý" decoration-danger="severity == 'critical'" decoration-warning="severity == 'high'"
                  decoration-muted="state == 'done'">
                <field name="state_rank" column_invisible="1"/>
                <field name="severity_rank" column_invisible="1"/>
                <field name="create_date" string="Ngày"/>
                <field name="severity" widget="badge" decoration-danger="severity in ('critical', 'high')"
                       decoration-warning="severity == 'medium'" decoration-muted="severity == 'low'"/>
                <field name="partner_id"/>
                <field name="source"/>
                <field name="nps_score" invisible="not has_score"/>
                <field name="has_score" column_invisible="1"/>
                <field name="topic"/>
                <field name="sentiment" widget="badge" decoration-danger="sentiment == 'negative'" decoration-success="sentiment == 'positive'"/>
                <field name="churn_risk" widget="boolean" string="Rời bỏ?"/>
                <field name="summary"/>
                <field name="suggested_action" optional="show"/>
                <field name="user_id" optional="show" widget="many2one_avatar_user"/>
                <field name="method" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'new'" decoration-warning="state == 'in_progress'"
                       decoration-success="state == 'done'"/>
            </tree>
        </field>
    </record>

    <record id="view_dmag_ai_feedback_form" model="ir.ui.view">
        <field name="name">dmag.ai.feedback.form</field>
        <field name="model">dmag.ai.feedback</field>
        <field name="arch" type="xml">
            <form string="Phản hồi khách hàng">
                <header>
                    <button name="action_start" type="object" string="Nhận xử lý" class="btn-primary" invisible="state != 'new'"/>
                    <button name="action_done" type="object" string="Đã xử lý" class="btn-primary" invisible="state == 'done'"/>
                    <button name="action_reclassify" type="object" string="Phân loại lại (AI)" invisible="state == 'done'"/>
                    <button name="action_open_source" type="object" string="Mở nguồn" icon="fa-external-link"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h2><field name="summary" placeholder="Tóm tắt"/></h2>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="not red_flags">
                        <b>Dấu hiệu cần bác sĩ xem:</b> <field name="red_flags" readonly="1" class="d-inline"/>
                    </div>
                    <group>
                        <group string="Phân loại">
                            <field name="severity"/>
                            <field name="topic"/>
                            <field name="sentiment"/>
                            <field name="churn_risk"/>
                            <field name="method" readonly="1"/>
                            <field name="method_note" readonly="1" invisible="not method_note"/>
                            <field name="estimated_cost_vnd" readonly="1"/>
                        </group>
                        <group string="Nguồn">
                            <field name="source" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="visit_id"/>
                            <field name="doctor_id"/>
                            <field name="has_score" invisible="1"/>
                            <field name="nps_score" invisible="not has_score" readonly="1"/>
                            <field name="nps_response_id" invisible="not nps_response_id"/>
                            <field name="conversation_id" invisible="not conversation_id"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <label for="text"/>
                    <field name="text" readonly="source != 'manual'"/>
                    <group>
                        <field name="suggested_reply" string="Gợi ý trả lời khách (nhân viên duyệt trước khi gửi)"/>
                        <field name="suggested_action"/>
                        <field name="resolution"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_dmag_ai_feedback_search" model="ir.ui.view">
        <field name="name">dmag.ai.feedback.search</field>
        <field name="model">dmag.ai.feedback</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/><field name="text"/>
                <filter name="open" string="Cần xử lý" domain="[('state', '!=', 'done')]"/>
                <filter name="severe" string="Cao / Khẩn" domain="[('severity', 'in', ('high', 'critical'))]"/>
                <filter name="churn" string="Nguy cơ rời bỏ" domain="[('churn_risk', '=', True)]"/>
                <filter name="negative" string="Tiêu cực" domain="[('sentiment', '=', 'negative')]"/>
                <separator/>
                <filter name="mine" string="Của tôi" domain="[('user_id', '=', uid)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="g_topic" string="Chủ đề" context="{'group_by': 'topic'}"/>
                    <filter name="g_severity" string="Mức độ" context="{'group_by': 'severity'}"/>
                    <filter name="g_doctor" string="Bác sĩ" context="{'group_by': 'doctor_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dmag_ai_feedback_backlog" model="ir.actions.server">
        <field name="name">Phân loại phản hồi NPS cũ (AI-09)</field>
        <field name="model_id" ref="model_dmag_ai_feedback"/>
        <field name="binding_model_id" ref="model_dmag_ai_feedback"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = model.action_classify_backlog()</field>
    </record>

    <record id="action_dmag_ai_feedback" model="ir.actions.act_window">
        <field name="name">Phản hồi cần xử lý</field>
        <field name="res_model">dmag.ai.feedback</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có phản hồi cần xử lý</p>
            <p>Góp ý NPS, tin nhắn Zalo tiêu cực được AI-09 phân loại chủ đề, mức độ, cảm xúc, nguy cơ rời bỏ và gợi ý xử lý.</p>
        </field>
    </record>
</odoo>
