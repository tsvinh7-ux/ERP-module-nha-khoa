<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kịch bản trả lời đã duyệt -->
    <record id="view_dmag_ai_reply_script_tree" model="ir.ui.view">
        <field name="name">dmag.ai.reply.script.tree</field>
        <field name="model">dmag.ai.reply.script</field>
        <field name="arch" type="xml">
            <tree string="Kịch bản trả lời đã duyệt" decoration-muted="not active" decoration-warning="state == 'draft'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" optional="hide"/>
                <field name="category" widget="badge"/>
                <field name="flow"/>
                <field name="origin" widget="badge" decoration-info="origin == 'proposal'" optional="show"/>
                <field name="proposed_by_id" string="Người đề xuất" optional="show"/>
                <field name="tool_ids" widget="many2many_tags" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-warning="state == 'draft'"/>
                <field name="approved_by_id" optional="show"/>
                <field name="approved_at" optional="hide"/>
                <field name="usage_count" string="Đã tự trả lời"/>
                <field name="example_count" string="Ví dụ" optional="show"/>
                <field name="active" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_dmag_ai_reply_script_form" model="ir.ui.view">
        <field name="name">dmag.ai.reply.script.form</field>
        <field name="model">dmag.ai.reply.script</field>
        <field name="arch" type="xml">
            <form string="Kịch bản trả lời">
                <header>
                    <button name="action_approve" type="object" string="Duyệt kịch bản" class="btn-primary"
                            invisible="state != 'draft'" groups="dmag_dental_base.group_dmag_director"/>
                    <button name="action_reset_draft" type="object" string="Mở lại để sửa" invisible="state != 'approved'"
                            groups="dmag_dental_base.group_dmag_director"
                            confirm="Trợ lý sẽ ngừng tự trả lời theo kịch bản này cho tới khi được duyệt lại. Tiếp tục?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_examples" type="object" class="oe_stat_button" icon="fa-comments-o">
                            <field name="example_count" widget="statinfo" string="Ví dụ hỏi – đáp"/>
                        </button>
                        <button name="action_view_usage" type="object" class="oe_stat_button" icon="fa-bolt">
                            <field name="usage_count" widget="statinfo" string="Lần tự trả lời"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Đã duyệt" bg_color="text-bg-success" invisible="state != 'approved'"/>
                    <widget name="web_ribbon" title="Lưu trữ" bg_color="text-bg-secondary" invisible="active"/>
                    <div class="alert alert-success mb-3" role="status" invisible="state != 'approved'">
                        <i class="fa fa-lock me-1" title="Đã khóa"/><field name="approval_banner" readonly="1" class="d-inline fw-bold"/>.
                        Trợ lý được tự gửi khi tin của khách khớp kịch bản này với độ tin cậy ≥ ngưỡng.
                    </div>
                    <div class="alert alert-info mb-3" role="status" invisible="state != 'draft' or origin != 'proposal'">
                        <i class="fa fa-lightbulb-o me-1" title="Đề xuất"/><b>Đề xuất của <field name="proposed_by_id" readonly="1" class="d-inline"/></b> từ
                        câu trả lời trong Hộp thư trợ lý. Giám đốc đọc lại, thay số liệu cố định bằng ô dữ liệu ({gia_dich_vu}, {gio_lam_viec}…) rồi duyệt.
                    </div>
                    <div class="alert alert-warning mb-3" role="status" invisible="state != 'draft'">
                        Bản nháp – trợ lý <b>chưa</b> dùng. Quản lý soạn / sửa, Giám đốc bấm <b>Duyệt kịch bản</b>.
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="state == 'approved'" placeholder="Ví dụ: Giá dịch vụ"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" readonly="state == 'approved'"/>
                            <field name="category" readonly="state == 'approved'"/>
                            <field name="flow" widget="radio" readonly="state == 'approved'"/>
                            <field name="handoff_reason" invisible="flow != 'handoff'" readonly="state == 'approved'"/>
                        </group>
                        <group>
                            <field name="tool_ids" widget="many2many_checkboxes" readonly="state == 'approved'"/>
                            <field name="doctor_scope" readonly="state == 'approved'" invisible="'bac_si_lam_viec' not in (answer_template or '')"/>
                            <field name="allow_rephrase" readonly="state == 'approved'"/>
                            <field name="min_confidence" widget="percentage" readonly="state == 'approved'"
                                   invisible="state == 'approved' and not min_confidence"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state == 'approved'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Câu hỏi của khách &amp; mẫu trả lời" name="content">
                            <group>
                                <group string="Khách thường hỏi">
                                    <field name="sample_questions" nolabel="1" colspan="2" readonly="state == 'approved'"
                                           placeholder="Mỗi dòng một cách hỏi…"/>
                                    <field name="keywords" readonly="state == 'approved'" placeholder="giá, bao nhiêu tiền, chi phí"/>
                                </group>
                                <group string="Mẫu trả lời đã duyệt">
                                    <field name="answer_template" nolabel="1" colspan="2" readonly="state == 'approved'"/>
                                    <field name="quick_replies" readonly="state == 'approved'"/>
                                    <field name="service_ids" widget="many2many_tags" readonly="state == 'approved'"/>
                                </group>
                            </group>
                            <group string="Xem trước với dữ liệu thật">
                                <field name="preview" nolabel="1" colspan="2" class="o_dmag_preview"/>
                            </group>
                        </page>
                        <page string="Ô dữ liệu" name="placeholders">
                            <field name="placeholder_help" nolabel="1"/>
                        </page>
                        <page string="Ví dụ hỏi – đáp (few-shot)" name="examples">
                            <field name="example_ids">
                                <tree decoration-warning="state == 'draft'">
                                    <field name="question"/>
                                    <field name="answer"/>
                                    <field name="state" widget="badge" decoration-success="state == 'approved'"/>
                                    <field name="proposed_by_id" optional="show"/>
                                    <field name="approved_by_id" optional="show"/>
                                    <button name="action_approve" type="object" string="Duyệt" icon="fa-check"
                                            invisible="state != 'draft'" groups="dmag_dental_base.group_dmag_director"/>
                                </tree>
                                <form>
                                    <group>
                                        <field name="question" readonly="state == 'approved'"/>
                                        <field name="answer" readonly="state == 'approved'"/>
                                        <field name="state" readonly="1"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Nguồn đề xuất" name="source">
                            <group>
                                <field name="origin"/>
                                <field name="proposed_by_id"/>
                                <field name="source_message_id"/>
                                <field name="last_used_at"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_dmag_ai_reply_script_search" model="ir.ui.view">
        <field name="name">dmag.ai.reply.script.search</field>
        <field name="model">dmag.ai.reply.script</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="sample_questions"/>
                <field name="answer_template"/>
                <filter name="approved" string="Đã duyệt" domain="[('state', '=', 'approved')]"/>
                <filter name="draft" string="Chờ duyệt" domain="[('state', '=', 'draft')]"/>
                <filter name="proposals" string="Nhân viên đề xuất" domain="[('origin', '=', 'proposal')]"/>
                <separator/>
                <filter name="archived" string="Lưu trữ" domain="[('active', '=', False)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_category" string="Nhóm" context="{'group_by': 'category'}"/>
                    <filter name="group_state" string="Trạng thái" context="{'group_by': 'state'}"/>
                    <filter name="group_origin" string="Nguồn" context="{'group_by': 'origin'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dmag_ai_reply_script" model="ir.actions.act_window">
        <field name="name">Kịch bản trả lời đã duyệt</field>
        <field name="res_model">dmag.ai.reply.script</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có kịch bản trả lời</p>
            <p>Trợ lý Zalo chỉ tự trả lời khi tin của khách khớp một kịch bản Giám đốc đã duyệt. Quản lý soạn kịch bản
               (hoặc đề xuất một chạm từ Hộp thư trợ lý), Giám đốc duyệt.</p>
        </field>
    </record>

    <record id="action_dmag_ai_reply_script_load_samples" model="ir.actions.server">
        <field name="name">Nạp kịch bản mẫu</field>
        <field name="model_id" ref="model_dmag_ai_reply_script"/>
        <field name="binding_model_id" ref="model_dmag_ai_reply_script"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('dmag_dental_base.group_dmag_manager'))]"/>
        <field name="state">code</field>
        <field name="code">action = model.action_load_samples()</field>
    </record>

    <!-- Ví dụ hỏi – đáp -->
    <record id="view_dmag_ai_reply_example_tree" model="ir.ui.view">
        <field name="name">dmag.ai.reply.example.tree</field>
        <field name="model">dmag.ai.reply.example</field>
        <field name="arch" type="xml">
            <tree string="Ví dụ hỏi – đáp" decoration-warning="state == 'draft'" create="0">
                <field name="script_id"/>
                <field name="question"/>
                <field name="answer"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'"/>
                <field name="proposed_by_id"/>
                <field name="approved_by_id" optional="show"/>
                <button name="action_approve" type="object" string="Duyệt" icon="fa-check" invisible="state != 'draft'"
                        groups="dmag_dental_base.group_dmag_director"/>
            </tree>
        </field>
    </record>
    <record id="view_dmag_ai_reply_example_form" model="ir.ui.view">
        <field name="name">dmag.ai.reply.example.form</field>
        <field name="model">dmag.ai.reply.example</field>
        <field name="arch" type="xml">
            <form string="Ví dụ hỏi – đáp">
                <header>
                    <button name="action_approve" type="object" string="Duyệt ví dụ" class="btn-primary"
                            invisible="state != 'draft'" groups="dmag_dental_base.group_dmag_director"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="script_id" readonly="state == 'approved'"/>
                        <field name="question" readonly="state == 'approved'"/>
                        <field name="answer" readonly="state == 'approved'"/>
                        <field name="proposed_by_id"/>
                        <field name="approved_by_id"/>
                        <field name="approved_at"/>
                        <field name="source_message_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_dmag_ai_reply_example_search" model="ir.ui.view">
        <field name="name">dmag.ai.reply.example.search</field>
        <field name="model">dmag.ai.reply.example</field>
        <field name="arch" type="xml">
            <search>
                <field name="question"/>
                <field name="script_id"/>
                <filter name="draft" string="Chờ Giám đốc duyệt" domain="[('state', '=', 'draft')]"/>
                <filter name="approved" string="Đã duyệt" domain="[('state', '=', 'approved')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_script" string="Kịch bản" context="{'group_by': 'script_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_dmag_ai_reply_example" model="ir.actions.act_window">
        <field name="name">Ví dụ hỏi – đáp (huấn luyện)</field>
        <field name="res_model">dmag.ai.reply.example</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_draft': 1}</field>
    </record>
</odoo>
