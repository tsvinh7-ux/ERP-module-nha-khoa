<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dmag_ai_customer.AiBadge">
        <span t-att-class="'dmag-ai-badge is-' + (props.mode || 'simulate')" t-att-title="tooltip">
            <i t-att-class="'fa me-1 ' + (props.mode === 'local' ? 'fa-microchip' : 'fa-magic')" title="AI"/><t t-esc="text"/>
        </span>
    </t>

    <!-- Bong bóng tin nhắn dùng chung (mô phỏng Zalo & hộp thư) – biến: chatLines, chatPerspective ('customer'|'staff') -->
    <t t-name="dmag_ai_customer.ChatBubbles">
        <t t-foreach="chatLines" t-as="m" t-key="m.id">
            <t t-set="mine" t-value="chatPerspective === 'customer' ? m.role === 'customer' : ['bot', 'staff'].includes(m.role)"/>
            <div t-if="m.role === 'system' and chatPerspective === 'staff' and m.decision === 'out_of_data'" class="dmag-ai-sysmsg is-gap">
                <i class="fa fa-bell me-1" title="Ngoài dữ liệu"/><t t-esc="m.decision_note"/><div class="small text-muted" t-if="m.state !== 'received'">Khách nhận: “<t t-esc="m.body"/>”</div>
            </div>
            <div t-elif="m.role === 'system' and !(chatPerspective === 'customer' and m.decision)" class="dmag-ai-sysmsg" t-esc="m.body"/>
            <div t-else="" t-att-class="'dmag-ai-bubble-row' + (mine ? ' is-mine' : '')">
                <div t-att-class="'dmag-ai-bubble is-' + m.role + (m.state === 'pending' ? ' is-pending' : '') + (m.state === 'discarded' ? ' is-discarded' : '')">
                    <div t-if="m.role !== 'customer'" class="dmag-ai-bubble-who">
                        <t t-if="m.role === 'bot' or m.role === 'system'"><i class="fa fa-magic me-1" title="Trợ lý AI"/>Trợ lý AI</t>
                        <t t-else=""><i class="fa fa-user me-1" title="Nhân viên"/><t t-esc="m.author or 'Nhân viên'"/></t>
                    </div>
                    <div class="dmag-ai-bubble-body" t-esc="m.body"/>
                    <div class="dmag-ai-bubble-meta">
                        <t t-esc="m.time"/>
                        <t t-if="m.role === 'bot' and chatPerspective === 'staff'"> · <t t-esc="m.simulated ? 'Giả lập' : 'Claude'"/></t>
                        <t t-if="m.state === 'pending'"> · <b>Chờ duyệt</b></t>
                        <t t-if="m.state === 'mock_sent'"> · Đã gửi (giả lập)</t>
                        <t t-if="m.state === 'sent'"> · Đã gửi Zalo</t>
                        <t t-if="m.state === 'failed'"> · <span class="text-danger">Gửi lỗi</span></t>
                    </div>
                    <div t-if="chatPerspective === 'staff' and m.decision and m.role === 'bot'"
                         t-att-class="'dmag-ai-bubble-tag ' + (m.auto ? 'is-ok' : 'is-warning')">
                        <t t-if="m.sources and m.sources.length">Trả lời từ: <t t-esc="m.sources.map((s) => s.label).join(' · ')"/></t>
                        <t t-elif="m.script and m.auto">Kịch bản: <t t-esc="m.script.name"/><t t-if="m.confidence"> · <t t-esc="m.confidence"/>%</t></t>
                        <t t-else="" t-esc="m.decision_label"/>
                        <t t-if="m.edited"> · nhân viên đã sửa</t>
                    </div>
                </div>
            </div>
        </t>
    </t>
</templates>
