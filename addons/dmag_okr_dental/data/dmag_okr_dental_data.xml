<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Ngưỡng cầu chì theo OKR mẫu DMAG – Giám đốc điều chỉnh được. -->
    <record id="guardrail_complaint_rate" model="dmag.okr.guardrail">
        <field name="name">Tỷ lệ phàn nàn &gt; 2%/tháng</field>
        <field name="sequence">10</field>
        <field name="metric">complaint_rate</field>
        <field name="threshold">2</field>
        <field name="unit">%</field>
    </record>
    <record id="guardrail_ortho_cancel" model="dmag.okr.guardrail">
        <field name="name">Hủy hợp đồng niềng trong 30 ngày &gt; 5%</field>
        <field name="sequence">20</field>
        <field name="metric">ortho_cancel_30d</field>
        <field name="threshold">5</field>
        <field name="unit">%</field>
    </record>
    <record id="guardrail_low_reviews" model="dmag.okr.guardrail">
        <field name="name">Đánh giá 1–2 sao &gt; 3/tháng</field>
        <field name="sequence">30</field>
        <field name="metric">low_reviews</field>
        <field name="threshold">3</field>
        <field name="unit">đánh giá</field>
    </record>
</odoo>
