<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_dmag_okr_guardrail_company" model="ir.rule">
        <field name="name">Chỉ số cầu chì OKR: theo phòng khám</field>
        <field name="model_id" ref="model_dmag_okr_guardrail"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="ir_cron_dmag_okr_refresh" model="ir.cron">
        <field name="name">OKR nha khoa: cập nhật KR tự đo &amp; chỉ số cầu chì</field>
        <field name="model_id" ref="okr_scale.model_okr_scale_key_result"/>
        <field name="state">code</field>
        <field name="code">model._cron_dmag_refresh()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
    </record>
</odoo>
