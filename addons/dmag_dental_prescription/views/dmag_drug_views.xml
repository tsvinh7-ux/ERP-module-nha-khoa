<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dmag_drug_form" model="ir.ui.view">
        <field name="name">dmag.drug.form</field>
        <field name="model">dmag.drug</field>
        <field name="arch" type="xml">
            <form string="Thuốc">
                <sheet>
                    <widget name="web_ribbon" title="Lưu trữ" bg_color="text-bg-danger" invisible="active"/>
                    <widget name="web_ribbon" title="Thực phẩm chức năng – không kê đơn" bg_color="text-bg-warning" invisible="not is_supplement"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Thông tin thuốc">
                            <field name="inn_name" placeholder="Ví dụ: Amoxicillin"/>
                            <field name="strength" placeholder="Ví dụ: 500 mg"/>
                            <field name="dosage_form"/>
                            <field name="brand_name"/>
                            <field name="multi_ingredient"/>
                            <field name="registration_number"/>
                            <field name="national_code"/>
                        </group>
                        <group string="Đơn vị và cách dùng">
                            <field name="unit"/>
                            <field name="dose_unit" placeholder="Để trống = đơn vị tính"/>
                            <field name="route"/>
                            <field name="default_dose_per_time"/>
                            <field name="default_times_per_day"/>
                            <field name="default_days"/>
                            <field name="default_timing"/>
                        </group>
                        <group string="Phân loại quản lý">
                            <field name="is_narcotic"/>
                            <field name="is_psychotropic"/>
                            <field name="is_supplement"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Chống chỉ định, tương tác thuốc, lưu ý…"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dmag_drug_tree" model="ir.ui.view">
        <field name="name">dmag.drug.tree</field>
        <field name="model">dmag.drug</field>
        <field name="arch" type="xml">
            <tree string="Danh mục thuốc" decoration-muted="is_supplement" decoration-danger="is_narcotic or is_psychotropic">
                <field name="name"/>
                <field name="inn_name" optional="hide"/>
                <field name="dosage_form"/>
                <field name="unit"/>
                <field name="route"/>
                <field name="registration_number" optional="show"/>
                <field name="national_code" optional="hide"/>
                <field name="is_narcotic" optional="show"/>
                <field name="is_psychotropic" optional="show"/>
                <field name="is_supplement" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_dmag_drug_search" model="ir.ui.view">
        <field name="name">dmag.drug.search</field>
        <field name="model">dmag.drug</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="inn_name"/>
                <field name="brand_name"/>
                <field name="registration_number"/>
                <filter name="controlled" string="Gây nghiện / hướng thần" domain="['|', ('is_narcotic', '=', True), ('is_psychotropic', '=', True)]"/>
                <filter name="supplement" string="Thực phẩm chức năng" domain="[('is_supplement', '=', True)]"/>
                <separator/>
                <filter name="archived" string="Đã lưu trữ" domain="[('active', '=', False)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_route" string="Đường dùng" context="{'group_by': 'route'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dmag_drug" model="ir.actions.act_window">
        <field name="name">Danh mục thuốc</field>
        <field name="res_model">dmag.drug</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Thêm thuốc vào danh mục kê đơn</p>
            <p>Tên thuốc trên đơn tự ghi theo TT 26/2025/TT-BYT: thuốc một hoạt chất ghi tên chung kèm hàm lượng
               (tên thương mại trong ngoặc); thuốc nhiều hoạt chất ghi tên thương mại.</p>
        </field>
    </record>
</odoo>
