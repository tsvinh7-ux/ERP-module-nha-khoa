<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dmag_rx_template_form" model="ir.ui.view">
        <field name="name">dmag.prescription.template.form</field>
        <field name="model">dmag.prescription.template</field>
        <field name="arch" type="xml">
            <form string="Đơn thuốc mẫu">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ví dụ: Sau nhổ răng khôn"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="diagnosis_ids" widget="many2many_tags"/>
                            <field name="re_exam_days"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="drug_id" domain="[('is_supplement', '=', False)]"/>
                            <field name="dose_per_time"/>
                            <field name="times_per_day"/>
                            <field name="days"/>
                            <field name="timing"/>
                            <field name="route" optional="hide"/>
                            <field name="quantity"/>
                            <field name="unit"/>
                            <field name="usage_note" optional="hide"/>
                            <field name="usage"/>
                        </tree>
                    </field>
                    <group string="Lời dặn">
                        <field name="advice" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dmag_rx_template_tree" model="ir.ui.view">
        <field name="name">dmag.prescription.template.tree</field>
        <field name="model">dmag.prescription.template</field>
        <field name="arch" type="xml">
            <tree string="Đơn thuốc mẫu">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="diagnosis_ids" widget="many2many_tags"/>
                <field name="re_exam_days"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="action_dmag_rx_template" model="ir.actions.act_window">
        <field name="name">Đơn thuốc mẫu</field>
        <field name="res_model">dmag.prescription.template</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
