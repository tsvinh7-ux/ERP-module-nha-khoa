<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bác sĩ tạo / phát hành đơn; phụ tá đọc; lễ tân đọc + in; chỉ Giám đốc hủy đơn đã phát hành
         (đơn đã phát hành không sửa nội dung – kê đơn thay thế theo TT 26/2025). -->
    <record id="rule_dmag_drug_company" model="ir.rule">
        <field name="name">Danh mục thuốc: theo phòng khám</field>
        <field name="model_id" ref="model_dmag_drug"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_dmag_rx_template_company" model="ir.rule">
        <field name="name">Đơn thuốc mẫu: theo phòng khám</field>
        <field name="model_id" ref="model_dmag_prescription_template"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_dmag_prescription_company" model="ir.rule">
        <field name="name">Đơn thuốc: theo phòng khám</field>
        <field name="model_id" ref="model_dmag_prescription"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_dmag_prescription_line_company" model="ir.rule">
        <field name="name">Dòng đơn thuốc: theo phòng khám</field>
        <field name="model_id" ref="model_dmag_prescription_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_dmag_rx_config_company" model="ir.rule">
        <field name="name">Cấu hình liên thông đơn thuốc: theo phòng khám</field>
        <field name="model_id" ref="model_dmag_rx_national_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_dmag_rx_log_company" model="ir.rule">
        <field name="name">Nhật ký liên thông đơn thuốc: theo phòng khám</field>
        <field name="model_id" ref="model_dmag_rx_send_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
