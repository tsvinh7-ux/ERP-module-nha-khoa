<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dmag_compliance_doc_form" model="ir.ui.view">
        <field name="name">dmag.compliance.doc.form</field>
        <field name="model">dmag.compliance.doc</field>
        <field name="arch" type="xml">
            <form string="Hồ sơ pháp chế">
                <header>
                    <button name="action_renew" type="object" string="Gia hạn" class="btn-primary"
                            invisible="state == 'valid' or not id" groups="dmag_dental_base.group_dmag_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Hết hạn" bg_color="text-bg-danger" invisible="state != 'expired'"/>
                    <widget name="web_ribbon" title="Sắp hết hạn" bg_color="text-bg-warning" invisible="state != 'expiring'"/>
                    <widget name="web_ribbon" title="Lưu trữ" bg_color="text-bg-secondary" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="VD: Giấy phép hoạt động PK RHM số …"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="type_id" options="{'no_create': True}"/>
                            <field name="category"/>
                            <field name="number"/>
                            <field name="issuer"/>
                            <field name="partner_id"/>
                            <field name="practitioner_id" options="{'no_create': True}"/>
                            <field name="equipment_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="no_expiry"/>
                            <field name="expiry_date" invisible="no_expiry" required="not no_expiry"/>
                            <field name="alert_days" invisible="no_expiry"/>
                            <field name="days_left" invisible="no_expiry or not expiry_date"/>
                            <field name="responsible_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="renewed_from_id" invisible="not renewed_from_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Bản scan" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Căn cứ pháp lý" name="legal">
                            <field name="legal_basis"/>
                        </page>
                        <page string="Ghi chú" name="note"><field name="note"/></page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_dmag_compliance_doc_tree" model="ir.ui.view">
        <field name="name">dmag.compliance.doc.tree</field>
        <field name="model">dmag.compliance.doc</field>
        <field name="arch" type="xml">
            <tree string="Hồ sơ pháp chế" decoration-danger="state == 'expired'" decoration-warning="state == 'expiring'">
                <field name="type_id"/>
                <field name="name"/>
                <field name="number" optional="show"/>
                <field name="practitioner_id" optional="show"/>
                <field name="equipment_id" optional="show"/>
                <field name="issue_date" optional="hide"/>
                <field name="expiry_date"/>
                <field name="days_left" optional="show"/>
                <field name="responsible_id" optional="show" widget="many2one_avatar_user"/>
                <field name="state" widget="badge" decoration-success="state == 'valid'"
                       decoration-warning="state == 'expiring'" decoration-danger="state == 'expired'"/>
            </tree>
        </field>
    </record>

    <record id="view_dmag_compliance_doc_search" model="ir.ui.view">
        <field name="name">dmag.compliance.doc.search</field>
        <field name="model">dmag.compliance.doc</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="number"/>
                <field name="type_id"/>
                <field name="practitioner_id"/>
                <field name="equipment_id"/>
                <filter name="red" string="Cần xử lý" domain="[('state', 'in', ('expiring', 'expired'))]"/>
                <filter name="expired" string="Hết hạn" domain="[('state', '=', 'expired')]"/>
                <filter name="expiring" string="Sắp hết hạn" domain="[('state', '=', 'expiring')]"/>
                <filter name="valid" string="Còn hiệu lực" domain="[('state', '=', 'valid')]"/>
                <separator/>
                <filter name="archived" string="Lưu trữ" domain="[('active', '=', False)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_category" string="Nhóm" context="{'group_by': 'category'}"/>
                    <filter name="group_type" string="Loại hồ sơ" context="{'group_by': 'type_id'}"/>
                    <filter name="group_responsible" string="Người phụ trách" context="{'group_by': 'responsible_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dmag_compliance_doc" model="ir.actions.act_window">
        <field name="name">Hồ sơ pháp chế</field>
        <field name="res_model">dmag.compliance.doc</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_group_category': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nhập giấy phép, chứng chỉ, hợp đồng bắt buộc</p>
            <p>Hệ thống cảnh báo trước hạn theo từng loại hồ sơ và tổng hợp "Sẵn sàng thanh tra" cho chủ phòng khám.</p>
        </field>
    </record>

    <record id="view_dmag_compliance_doc_type_tree" model="ir.ui.view">
        <field name="name">dmag.compliance.doc.type.tree</field>
        <field name="model">dmag.compliance.doc.type</field>
        <field name="arch" type="xml">
            <tree string="Loại hồ sơ" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="validity_months"/>
                <field name="alert_days"/>
                <field name="is_mandatory"/>
                <field name="per_practitioner" optional="hide"/>
                <field name="per_equipment" optional="hide"/>
                <field name="equipment_categories" optional="hide"/>
                <field name="legal_basis" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="action_dmag_compliance_doc_type" model="ir.actions.act_window">
        <field name="name">Loại hồ sơ pháp chế</field>
        <field name="res_model">dmag.compliance.doc.type</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
