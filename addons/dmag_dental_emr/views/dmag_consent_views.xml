<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dmag_consent_form" model="ir.ui.view">
        <field name="name">dmag.consent.form</field>
        <field name="model">dmag.consent</field>
        <field name="arch" type="xml">
            <form string="Cam kết / đồng ý thực hiện thủ thuật">
                <header>
                    <button name="action_sign" type="object" string="Xác nhận người bệnh đã ký" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="%(action_report_consent)d" type="action" string="In giấy cam kết"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Đã ký – khóa" bg_color="text-bg-success" invisible="state != 'signed'"/>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Người bệnh">
                            <field name="patient_id" readonly="state == 'signed'" context="{'dmag_patient_search': True}"/>
                            <field name="patient_age"/>
                            <field name="visit_id" readonly="state == 'signed'"/>
                            <field name="plan_id" readonly="state == 'signed'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state == 'signed'"/>
                        </group>
                        <group string="Thủ thuật">
                            <field name="consent_type" readonly="state == 'signed'"/>
                            <field name="product_id" readonly="state == 'signed'"/>
                            <field name="procedure_name" readonly="state == 'signed'"/>
                            <field name="tooth_ids" widget="many2many_tags" readonly="state == 'signed'"/>
                            <field name="diagnosis" readonly="state == 'signed'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="expected_cost" readonly="state == 'signed'"/>
                            <field name="doctor_id" readonly="state == 'signed'"/>
                        </group>
                    </group>
                    <group>
                        <field name="risks" readonly="state == 'signed'"/>
                        <field name="alternatives" readonly="state == 'signed'"/>
                        <field name="consent_text" readonly="state == 'signed'"/>
                    </group>
                    <group string="Ký xác nhận">
                        <group>
                            <field name="signer_name" readonly="state == 'signed'"/>
                            <field name="guardian_name" readonly="state == 'signed'"/>
                            <field name="guardian_relation" readonly="state == 'signed'" invisible="not guardian_name"/>
                            <field name="guardian_identity" readonly="state == 'signed'" invisible="not guardian_name"/>
                            <field name="sign_method" readonly="state == 'signed'"/>
                            <field name="otp_reference" invisible="sign_method != 'otp'" readonly="state == 'signed'"/>
                            <field name="scan_file" filename="scan_filename" invisible="sign_method != 'paper'" readonly="state == 'signed'"/>
                            <field name="scan_filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="signature" widget="signature" invisible="sign_method != 'tablet'" readonly="state == 'signed'"/>
                            <field name="signed_at"/>
                            <field name="signed_ip"/>
                            <field name="recorded_by_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_dmag_consent_tree" model="ir.ui.view">
        <field name="name">dmag.consent.tree</field>
        <field name="model">dmag.consent</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'signed'">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="visit_id" optional="show"/>
                <field name="consent_type"/>
                <field name="procedure_name"/>
                <field name="doctor_id" optional="show"/>
                <field name="sign_method" optional="show"/>
                <field name="signed_at"/>
                <field name="state" widget="badge" decoration-success="state == 'signed'"/>
            </tree>
        </field>
    </record>

    <record id="view_dmag_consent_search" model="ir.ui.view">
        <field name="name">dmag.consent.search</field>
        <field name="model">dmag.consent</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="procedure_name"/>
                <filter name="draft" string="Chờ ký" domain="[('state', '=', 'draft')]"/>
                <filter name="signed" string="Đã ký" domain="[('state', '=', 'signed')]"/>
            </search>
        </field>
    </record>

    <record id="action_dmag_consent" model="ir.actions.act_window">
        <field name="name">Cam kết / đồng ý thủ thuật</field>
        <field name="res_model">dmag.consent</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
