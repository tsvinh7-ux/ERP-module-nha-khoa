<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dmag_payment_request_tree" model="ir.ui.view">
        <field name="name">dmag.payment.request.tree</field>
        <field name="model">dmag.payment.request</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'paid'" decoration-warning="state == 'partial'"
                  decoration-muted="state in ('expired', 'cancelled')">
                <field name="create_date" string="Tạo lúc"/>
                <field name="name"/>
                <field name="visit_id"/>
                <field name="patient_id"/>
                <field name="amount" sum="Tổng"/>
                <field name="paid_amount" sum="Đã nhận"/>
                <field name="state" widget="badge"/>
                <field name="expiry"/>
                <field name="create_uid" string="Người tạo" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_dmag_payment_request_form" model="ir.ui.view">
        <field name="name">dmag.payment.request.form</field>
        <field name="model">dmag.payment.request</field>
        <field name="arch" type="xml">
            <form string="Yêu cầu thanh toán" create="false">
                <header>
                    <button name="action_cancel" type="object" string="Hủy yêu cầu"
                            invisible="state not in ('pending', 'partial', 'expired')"
                            confirm="Hủy mã thanh toán này?"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,partial,paid"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="visit_id"/>
                            <field name="patient_id"/>
                            <field name="amount"/>
                            <field name="paid_amount"/>
                            <field name="residual"/>
                            <field name="expiry"/>
                            <field name="transfer_content"/>
                            <field name="note"/>
                            <field name="invoice_ids" widget="many2many_tags" groups="account.group_account_invoice"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="qr_url" widget="image_url" nolabel="1" colspan="2"
                                   options="{'size': [260, 260]}" invisible="state not in ('pending', 'partial')"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Giao dịch ngân hàng" name="transactions">
                            <field name="transaction_ids" readonly="1">
                                <tree>
                                    <field name="transaction_date"/>
                                    <field name="sepay_id"/>
                                    <field name="amount"/>
                                    <field name="content"/>
                                    <field name="state" widget="badge"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_dmag_payment_request_search" model="ir.ui.view">
        <field name="name">dmag.payment.request.search</field>
        <field name="model">dmag.payment.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="visit_id"/>
                <filter name="open" string="Chờ thanh toán" domain="[('state', 'in', ('pending', 'partial'))]"/>
                <filter name="paid" string="Đã thanh toán" domain="[('state', '=', 'paid')]"/>
                <separator/>
                <filter name="today" string="Hôm nay"
                        domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_state" string="Trạng thái" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dmag_payment_request" model="ir.actions.act_window">
        <field name="name">Yêu cầu thanh toán</field>
        <field name="res_model">dmag.payment.request</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có yêu cầu thanh toán</p>
            <p>Mở lượt khám và bấm "Mã QR chuyển khoản" để tạo mã VietQR cho bệnh nhân quét.</p>
        </field>
    </record>
</odoo>
