<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dmag_sepay_match_wizard_form" model="ir.ui.view">
        <field name="name">dmag.sepay.match.wizard.form</field>
        <field name="model">dmag.sepay.match.wizard</field>
        <field name="arch" type="xml">
            <form string="Đối soát thủ công">
                <group>
                    <group>
                        <field name="transaction_id"/>
                        <field name="content"/>
                        <field name="unapplied_amount"/>
                        <field name="company_id" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="request_id"/>
                        <field name="visit_id" required="not request_id"/>
                        <field name="visit_amount_due"/>
                        <field name="amount"/>
                        <field name="note"/>
                    </group>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Gạch nợ" class="btn-primary"/>
                    <button special="cancel" string="Hủy"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
