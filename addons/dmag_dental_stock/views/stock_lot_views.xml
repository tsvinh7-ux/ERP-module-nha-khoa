<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_production_lot_form_dmag" model="ir.ui.view">
        <field name="name">stock.lot.form.dmag</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="after">
                <group string="Truy xuất nha khoa" invisible="not dmag_patient_id">
                    <field name="dmag_patient_id"/>
                    <field name="dmag_procedure_id"/>
                    <field name="dmag_used_date"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
