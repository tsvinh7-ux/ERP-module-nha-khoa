<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_dmag_stock" model="ir.ui.view">
        <field name="name">res.company.form.dmag.stock</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="dmag_dental_base.view_company_form_dmag"/>
        <field name="arch" type="xml">
            <field name="dmag_max_discount" position="after">
                <field name="dmag_cogs_threshold"/>
                <field name="dmag_consumption_location_id" options="{'no_create': True}"/>
            </field>
        </field>
    </record>
</odoo>
