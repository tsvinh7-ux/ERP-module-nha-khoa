<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dmag_ai_anomaly_tree" model="ir.ui.view">
        <field name="name">dmag.ai.anomaly.tree</field>
        <field name="model">dmag.ai.anomaly</field>
        <field name="arch" type="xml">
            <tree string="Cảnh báo bất thường" create="0" decoration-danger="severity == 'high' and state == 'new'"
                  decoration-warning="severity == 'medium' and state == 'new'" decoration-muted="state in ('closed', 'dismissed')">
                <field name="date"/>
                <field name="severity" widget="badge" decoration-danger="severity == 'high'" decoration-warning="severity == 'medium'"/>
                <field name="kind"/>
                <field name="name"/>
                <field name="subject"/>
                <field name="score"/>
                <field name="amount" sum="Tổng"/>
                <field name="doc_count"/>
                <field name="state" widget="badge" decoration-success="state == 'closed'" decoration-info="state == 'review'"/>
            </tree>
        </field>
    </record>
    <record id="view_dmag_ai_anomaly_form" model="ir.ui.view">
        <field name="name">dmag.ai.anomaly.form</field>
        <field name="model">dmag.ai.anomaly</field>
        <field name="arch" type="xml">
            <form string="Cảnh báo bất thường" create="0">
                <header>
                    <button name="action_review" type="object" string="Gửi giải trình cho Giám đốc" class="btn-primary"
                            invisible="state != 'new'" groups="dmag_dental_base.group_dmag_manager"/>
                    <button name="action_close" type="object" string="Đóng cảnh báo" class="btn-primary"
                            invisible="state not in ('new', 'review')" groups="dmag_dental_base.group_dmag_director"/>
                    <button name="action_dismiss" type="object" string="Không phải bất thường"
                            invisible="state not in ('new', 'review')" groups="dmag_dental_base.group_dmag_director"/>
                    <button name="action_reopen" type="object" string="Mở lại"
                            invisible="state not in ('closed', 'dismissed')" groups="dmag_dental_base.group_dmag_director"/>
                    <button name="action_ai_narrative" type="object" string="AI giải thích" icon="fa-magic"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,review,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_documents" type="object" class="oe_stat_button" icon="fa-files-o"
                                invisible="not doc_count">
                            <field name="doc_count" widget="statinfo" string="Xem chứng từ"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="kind" readonly="1"/>
                            <field name="severity"/>
                            <field name="score" readonly="1"/>
                            <field name="amount" readonly="1"/>
                            <field name="subject" readonly="1"/>
                        </group>
                        <group>
                            <field name="date" readonly="1"/>
                            <field name="period_from" readonly="1"/>
                            <field name="period_to" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="practitioner_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Thống kê">
                        <field name="observed" readonly="1"/>
                        <field name="norm" readonly="1"/>
                        <field name="explanation" readonly="1"/>
                        <field name="ai_narrative" invisible="not ai_narrative"/>
                    </group>
                    <group string="Xử lý">
                        <field name="manager_note" readonly="state not in ('new', 'review')" placeholder="Nguyên nhân, đã kiểm tra gì, đã xử lý gì…"/>
                        <field name="reviewed_by_id"/>
                        <field name="director_note" readonly="state not in ('new', 'review')" groups="dmag_dental_base.group_dmag_director"/>
                        <field name="closed_by_id"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_dmag_ai_anomaly_search" model="ir.ui.view">
        <field name="name">dmag.ai.anomaly.search</field>
        <field name="model">dmag.ai.anomaly</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="subject"/>
                <filter name="open" string="Đang mở" domain="[('state', 'in', ('new', 'review'))]"/>
                <filter name="high" string="Mức cao" domain="[('severity', '=', 'high')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="g_kind" string="Loại" context="{'group_by': 'kind'}"/>
                    <filter name="g_state" string="Trạng thái" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_dmag_ai_anomaly" model="ir.actions.act_window">
        <field name="name">Cảnh báo bất thường (danh sách)</field>
        <field name="res_model">dmag.ai.anomaly</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
