<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dmag_visit_form_lab" model="ir.ui.view">
        <field name="name">dmag.dental.visit.form.lab</field>
        <field name="model">dmag.dental.visit</field>
        <field name="inherit_id" ref="dmag_dental_clinic.view_dmag_visit_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_lab_orders" type="object" class="oe_stat_button" icon="fa-flask">
                    <field name="lab_order_count" widget="statinfo" string="Labo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
