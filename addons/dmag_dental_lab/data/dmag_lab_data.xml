<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_dmag_lab_order" model="ir.sequence">
            <field name="name">Phiếu labo</field>
            <field name="code">dmag.lab.order</field>
            <field name="prefix">LAB%(y)s</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="product_lab_fee" model="product.product">
            <field name="name">Phí gia công labo</field>
            <field name="detailed_type">service</field>
            <field name="sale_ok" eval="False"/>
            <field name="purchase_ok" eval="True"/>
            <field name="purchase_method">purchase</field>
            <field name="list_price">0</field>
            <field name="taxes_id" eval="[(5, 0, 0)]"/>
            <field name="supplier_taxes_id" eval="[(5, 0, 0)]"/>
        </record>
    </data>
    <record id="ir_cron_dmag_lab_overdue" model="ir.cron">
        <field name="name">Nha khoa: nhắc phiếu labo trễ hạn</field>
        <field name="model_id" ref="model_dmag_lab_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_overdue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
    </record>
</odoo>
