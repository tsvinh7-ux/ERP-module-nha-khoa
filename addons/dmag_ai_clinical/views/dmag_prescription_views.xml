<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- AI-03: an toàn đơn thuốc trên form đơn thuốc – chặn mọi đường phát hành, Giám đốc duyệt vượt có ký chịu trách nhiệm -->
    <record id="view_dmag_prescription_form_rx_safety" model="ir.ui.view">
        <field name="name">dmag.prescription.form.rx.safety</field>
        <field name="model">dmag.prescription</field>
        <field name="inherit_id" ref="dmag_dental_prescription.view_dmag_prescription_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_issue']" position="after">
                <button name="action_request_override_button" type="object" string="Đề nghị Giám đốc duyệt vượt"
                        invisible="state != 'draft' or rx_safety_block_count == 0 or rx_safety_override"
                        groups="dmag_dental_base.group_dmag_doctor"/>
                <button name="action_open_override_wizard" type="object" string="Duyệt vượt &amp; ký chịu trách nhiệm"
                        class="btn-danger" invisible="state != 'draft' or rx_safety_block_count == 0"
                        groups="dmag_dental_base.group_dmag_director"/>
            </xpath>
            <xpath expr="//header" position="after">
                <div class="alert alert-danger mb-0" role="alert" invisible="state != 'draft' or rx_safety_block_count == 0">
                    <b><i class="fa fa-ban me-1" title="Chặn"/>Vi phạm quy tắc an toàn – không phát hành được</b>
                    (chỉ Giám đốc duyệt vượt):
                    <field name="rx_safety_blocks" readonly="1" class="d-block mt-1" style="white-space: pre-line"/>
                </div>
                <div class="alert alert-warning mb-0" role="status" invisible="not rx_safety_override">
                    <i class="fa fa-gavel me-1" title="Duyệt vượt"/><field name="rx_override_banner" readonly="1" class="d-inline fw-bold"/>
                    <span class="ms-2 text-muted">· Ký số bổ sung: <field name="rx_override_esign" readonly="1" class="d-inline"/></span>
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="An toàn đơn thuốc (AI-03)" name="rx_safety">
                    <group>
                        <group string="Quy tắc cố định hiện tại">
                            <field name="rx_safety_block_count"/>
                            <field name="rx_safety_blocks" style="white-space: pre-line"/>
                        </group>
                        <group string="Duyệt vượt – nhật ký kiểm soát">
                            <field name="rx_safety_override"/>
                            <field name="rx_override_uid"/>
                            <field name="rx_override_date"/>
                            <field name="rx_override_reason"/>
                            <field name="rx_override_rules" style="white-space: pre-line"/>
                            <field name="rx_override_esign"/>
                            <field name="rx_override_requested_uid"/>
                            <field name="rx_override_requested_at"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_dmag_rx_override_wizard_form" model="ir.ui.view">
        <field name="name">dmag.rx.override.wizard.form</field>
        <field name="model">dmag.rx.override.wizard</field>
        <field name="arch" type="xml">
            <form string="Duyệt vượt &amp; ký chịu trách nhiệm">
                <div class="alert alert-danger" role="alert">
                    Đơn thuốc vi phạm quy tắc an toàn CỐ ĐỊNH. Duyệt vượt được ghi vào hồ sơ đơn (người duyệt, thời điểm,
                    lý do, quy tắc bị vượt) và gửi yêu cầu ký số bổ sung (nếu phòng khám đã cấu hình ký số).
                </div>
                <group>
                    <field name="prescription_id"/>
                    <field name="rules" style="white-space: pre-line"/>
                    <field name="reason" placeholder="Ví dụ: Đã hỏi lại bệnh nhân – phản ứng cũ là buồn nôn, không phải dị ứng; theo dõi tại phòng khám 30 phút."/>
                    <field name="confirm"/>
                    <field name="issue_now"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Duyệt vượt &amp; ký chịu trách nhiệm" class="btn-danger"
                            invisible="not confirm"/>
                    <button string="Hủy" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
